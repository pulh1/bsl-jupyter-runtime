{
  "name": "bsl-notebook",
  "publisher": "onec-interactive",
  "version": "0.1.5",
  "displayName": "1C BSL Notebooks",
  "description": "BSL language services for %%bsl cells in local Jupyter notebooks, using the installed 1C BSL Language extension.",
  "categories": ["Notebooks", "Programming Languages"],
  "repository": {"type": "git", "url": "https://github.com/pulh1/bsl-jupyter-runtime.git", "directory": "packages/vscode"},
  "license": "GPL-3.0-only",
  "engines": {"vscode": "^1.136.0"},
  "main": "./out/src/extension.js",
  "extensionKind": ["workspace"],
  "activationEvents": ["onNotebook:jupyter-notebook"],
  "contributes": {
    "configuration": {
      "title": "1C BSL Notebooks",
      "properties": {
        "onecBsl.serverStartup": {
          "type": "string",
          "scope": "window",
          "default": "onDemand",
          "enum": ["onDemand", "onNotebookOpen"],
          "enumDescriptions": ["Start on the first BSL completion, hover, signature, or definition request.", "Start when a notebook with a %%bsl cell opens."],
          "description": "When to activate the installed 1C BSL Language extension for notebook cells."
        }
      }
    },
    "commands": [
      {"command": "onec-bsl.selectSources", "title": "1C BSL: Выбрать исходники проекта"},
      {"command": "onec-bsl.changeSources", "title": "1C BSL: Сменить исходники проекта"},
      {"command": "onec-bsl.clearSources", "title": "1C BSL: Сбросить исходники проекта"}
    ],
    "grammars": [{
      "scopeName": "onec.bsl.cell.injection",
      "path": "./syntaxes/bsl-cell.injection.tmLanguage.json",
      "injectTo": ["source.python"],
      "embeddedLanguages": {"meta.embedded.block.bsl": "bsl"}
    }]
  },
  "devDependencies": {
    "vscode-jsonrpc": "9.0.2",
    "@types/vscode": "1.136.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3",
    "tsx": "^4.0.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:host": "npm run compile && node out/test/runExtensionTests.js",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "package": "vsce package"
  }
}
