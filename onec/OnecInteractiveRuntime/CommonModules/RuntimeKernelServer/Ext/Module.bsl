Функция НачатьКонтекстОтладки(КонтекстОтладки) Экспорт
	e1cRuntimeКонтекст = RuntimeContextStoreServer.ПолучитьКонтекст();
	e1cRuntimeКонтекст.Вставить("КонтекстОтладки", КонтекстОтладки);
	Возврат Истина;
КонецФункции

Функция ВыполнитьКодТекущегоКонтекстаОтладки(Код) Экспорт
	e1cRuntimeКонтекст = RuntimeContextStoreServer.ПолучитьКонтекст();
	КонтекстОтладки = Неопределено;
	Если Не e1cRuntimeКонтекст.Свойство("КонтекстОтладки", КонтекстОтладки) Тогда
		ВызватьИсключение "e1cRuntimeКонтекст отладки не инициализирован";
	КонецЕсли;
	Если e1cRuntimeКонтекст.Свойство("РезультатИнструкции") Тогда
		e1cRuntimeКонтекст.Удалить("РезультатИнструкции");
	КонецЕсли;
	РезультатИнструкции = Неопределено;
	РезультатКонтекста = Неопределено;
	__OnecPinnedWorkerGenerationOriginal = Неопределено;
	__OnecPinnedWorkerGenerationSlotExists = e1cRuntimeКонтекст.Свойство("RuntimeWorkerPinnedOperationGeneration", __OnecPinnedWorkerGenerationOriginal);
	__OnecPinnedWorkerGeneration = __OnecPinnedWorkerGenerationOriginal;
	Попытка
		Выполнить(Код);
	Исключение
		ВосстановитьПинПоколенияWorker(e1cRuntimeКонтекст, __OnecPinnedWorkerGenerationSlotExists, __OnecPinnedWorkerGenerationOriginal);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьПинПоколенияWorker(e1cRuntimeКонтекст, __OnecPinnedWorkerGenerationSlotExists, __OnecPinnedWorkerGenerationOriginal);
	Если e1cRuntimeКонтекст.Свойство("РезультатИнструкции", РезультатКонтекста) Тогда
		Возврат РезультатКонтекста;
	КонецЕсли;
	Возврат РезультатИнструкции;
КонецФункции

Функция ПолучитьЗначениеКонтекстаОтладки(Имя) Экспорт
	e1cRuntimeКонтекст = RuntimeContextStoreServer.ПолучитьКонтекст();
	КонтекстОтладки = Неопределено;
	Если Не e1cRuntimeКонтекст.Свойство("КонтекстОтладки", КонтекстОтладки) Тогда
		ВызватьИсключение "e1cRuntimeКонтекст отладки не инициализирован";
	КонецЕсли;
	Значение = Неопределено;
	Если Не КонтекстОтладки.Свойство(Имя, Значение) Тогда
		ВызватьИсключение "Корень контекста отладки не найден: " + Имя;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ЗавершитьКонтекстОтладки() Экспорт
	e1cRuntimeКонтекст = RuntimeContextStoreServer.ПолучитьКонтекст();
	Если e1cRuntimeКонтекст.Свойство("КонтекстОтладки") Тогда
		e1cRuntimeКонтекст.Удалить("КонтекстОтладки");
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ВыполнитьВКонтекстеОтладки(КонтекстОтладки, Код) Экспорт
