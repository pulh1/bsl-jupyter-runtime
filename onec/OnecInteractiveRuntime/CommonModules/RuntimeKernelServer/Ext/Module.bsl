Функция СинтетическийCapture(НачальноеЗначение) Экспорт
	Скаляр = НачальноеЗначение;
	Результат = Новый Массив;
	Если Результат.Количество() = 0 Тогда // @runtime-synthetic-capture-a
		Результат.Добавить(Скаляр);
	КонецЕсли;
	Если Результат.Количество() = 1 Тогда // @runtime-synthetic-capture-b
		Скаляр = Скаляр + 1;
		Результат.Добавить(Скаляр);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура Запустить() Экспорт
	ИдентификаторПродуктаRuntime = "onec-interactive-runtime";
	ВерсияАртефактаRuntime = "0.1.2";
	ВерсияПротоколаRuntime = "1";
	Контекст = Новый Структура; // @runtime-server-extension-entry-breakpoint
	ТекущаяИнструкция = "";
	ИдентификаторКоманды = 0;
	ЗавершеннаяКоманда = 0;
	Результат = Неопределено;
	Ошибка = "";
	Пока Истина Цикл
		С = 1; // @runtime-server-extension-service-breakpoint
		Если ИдентификаторКоманды > ЗавершеннаяКоманда Тогда
			Результат = Неопределено;
			Ошибка = "";
			Попытка
				Выполнить(ТекущаяИнструкция);
			Исключение
				Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;
			ЗавершеннаяКоманда = ИдентификаторКоманды;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция НачатьКонтекстОтладкиВКонтексте(Контекст, АдресКонтекстаОтладки) Экспорт
	КонтекстОтладки = ПолучитьИзВременногоХранилища(АдресКонтекстаОтладки);
	Если КонтекстОтладки = Неопределено Тогда
		ВызватьИсключение "Контекст отладки отсутствует во временном хранилище";
	КонецЕсли;
	Контекст.Вставить("КонтекстОтладки", КонтекстОтладки);
	УдалитьИзВременногоХранилища(АдресКонтекстаОтладки);
	Возврат Истина;
КонецФункции

Функция ВыполнитьКодВКонтекстеОтладки(Контекст, Код) Экспорт
	КонтекстОтладки = Неопределено;
	Если Не Контекст.Свойство("КонтекстОтладки", КонтекстОтладки) Тогда
		ВызватьИсключение "Контекст отладки не инициализирован";
	КонецЕсли;
	Если Контекст.Свойство("РезультатИнструкции") Тогда
		Контекст.Удалить("РезультатИнструкции");
	КонецЕсли;
	РезультатИнструкции = Неопределено;
	РезультатКонтекста = Неопределено;
	__OnecPinnedWorkerGenerationOriginal = Неопределено;
	__OnecPinnedWorkerGenerationSlotExists = Контекст.Свойство("RuntimeWorkerPinnedOperationGeneration", __OnecPinnedWorkerGenerationOriginal);
	__OnecPinnedWorkerGeneration = __OnecPinnedWorkerGenerationOriginal;
	Попытка
		Выполнить(Код);
	Исключение
		ВосстановитьПинПоколенияWorker(Контекст, __OnecPinnedWorkerGenerationSlotExists, __OnecPinnedWorkerGenerationOriginal);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьПинПоколенияWorker(Контекст, __OnecPinnedWorkerGenerationSlotExists, __OnecPinnedWorkerGenerationOriginal);
	Если Контекст.Свойство("РезультатИнструкции", РезультатКонтекста) Тогда
		Возврат РезультатКонтекста;
	КонецЕсли;
	Возврат РезультатИнструкции;
КонецФункции

Процедура ВосстановитьПинПоколенияWorker(Контекст, СлотСуществовал, ИсходноеЗначение)
	Если СлотСуществовал Тогда
		Контекст.Вставить("RuntimeWorkerPinnedOperationGeneration", ИсходноеЗначение);
	ИначеЕсли Контекст.Свойство("RuntimeWorkerPinnedOperationGeneration") Тогда
		Контекст.Удалить("RuntimeWorkerPinnedOperationGeneration");
	КонецЕсли;
КонецПроцедуры

Функция УстановитьПинПоколенияWorker(Контекст, ОжидаемыйManifestSha256) Экспорт
	АктивноеПоколениеWorker = Неопределено;
	Если Не Контекст.Свойство("RuntimeWorkerActiveGeneration", АктивноеПоколениеWorker) Тогда
		ВызватьИсключение "Active Worker generation is missing";
	КонецЕсли;
	Если АктивноеПоколениеWorker.ManifestSha256 <> ОжидаемыйManifestSha256 Тогда
		ВызватьИсключение "Worker generation pin mismatch";
	КонецЕсли;
	Контекст.Вставить("RuntimeWorkerPinnedOperationGeneration", АктивноеПоколениеWorker);
	Возврат Истина;
КонецФункции

