Функция ПолучитьОписательВременнойТаблицы(Менеджер, ИмяТаблицы)
	ОписательТаблицы = Менеджер.Таблицы.Найти(ИмяТаблицы);
	Если ОписательТаблицы = Неопределено Тогда
		ВызватьИсключение "Временная таблица не найдена";
	КонецЕсли;
	Возврат ОписательТаблицы;
КонецФункции

// Возвращает только объявленные колонки описателя временной таблицы. Данные
// строк не запрашиваются и не копируются.
Функция ПолучитьСхемуВременнойТаблицыОтладки(Менеджер, ИмяТаблицы) Экспорт
	ОписательТаблицы = ПолучитьОписательВременнойТаблицы(Менеджер, ИмяТаблицы);
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Имя");
	Для Каждого Колонка Из ОписательТаблицы.Колонки Цикл
		СтрокаСхемы = Результат.Добавить();
		СтрокаСхемы.Имя = Колонка.Имя;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Сохраняет только явно ограниченную выборку временной таблицы в server
// Context. Параметры строятся адаптером из валидированных идентификаторов и
// ограничений; этот модуль не выполняет агентский текст как код.
Функция СохранитьВременнуюТаблицуОтладки(Контекст, Менеджер, ИмяТаблицы, Ключ, Смещение = 0, Лимит = 0, Колонки = Неопределено) Экспорт
	Если Лимит <= 0 Тогда
		ВызватьИсключение "Для данных временной таблицы требуется положительный лимит";
	КонецЕсли;
	ОписательТаблицы = ПолучитьОписательВременнойТаблицы(Менеджер, ИмяТаблицы);
	РезультатДанных = ОписательТаблицы.ПолучитьДанные();
	Результат = Новый ТаблицаЗначений;
	Если Колонки = Неопределено Или Колонки.Количество() = 0 Тогда
		Для Каждого Колонка Из РезультатДанных.Колонки Цикл
			Результат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		КонецЦикла;
	Иначе
		Для Каждого ИмяКолонки Из Колонки Цикл
			ИсходнаяКолонка = РезультатДанных.Колонки.Найти(ИмяКолонки);
			Если ИсходнаяКолонка = Неопределено Тогда
				ВызватьИсключение "Колонка временной таблицы не найдена";
			КонецЕсли;
			Результат.Колонки.Добавить(ИсходнаяКолонка.Имя, ИсходнаяКолонка.ТипЗначения);
		КонецЦикла;
	КонецЕсли;
	Индекс = 0;
	ВыборкаДанных = РезультатДанных.Выбрать();
	Пока ВыборкаДанных.Следующий() Цикл
		Если Индекс >= Смещение И (Лимит = 0 Или Результат.Количество() < Лимит) Тогда
			СтрокаРезультата = Результат.Добавить();
			Для Каждого КолонкаРезультата Из Результат.Колонки Цикл
				СтрокаРезультата[КолонкаРезультата.Имя] = ВыборкаДанных[КолонкаРезультата.Имя];
			КонецЦикла;
		КонецЕсли;
		Индекс = Индекс + 1;
		Если Лимит > 0 И Результат.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Контекст.Вставить(Ключ, Результат);
	Возврат Истина;
КонецФункции

Процедура ДобавитьСообщение(Сообщения, Текст, Статус = Неопределено) Экспорт
	// Статус сохраняет совместимую сигнатуру Сообщить; notebook выводит текст.
	Сообщения.Добавить(Строка(Текст));
КонецПроцедуры

Процедура ЗавершитьСообщенияЯчейки(Ключ) Экспорт
	Контекст = RuntimeContextStoreServer.ПолучитьКонтекст();
	Сообщения = Неопределено;
	Если Контекст.Свойство(Ключ, Сообщения) Тогда
		Контекст.Удалить(Ключ);
		Контекст.Вставить("__onec_cell_messages_result_key", Ключ);
		Контекст.Вставить("__onec_cell_messages_result", Сообщения);
	КонецЕсли;
КонецПроцедуры

Функция ЗабратьСообщенияЯчейки(Ключ) Экспорт
	Контекст = RuntimeContextStoreServer.ПолучитьКонтекст();
	Возврат ЗабратьСообщенияЯчейкиИзКонтекста(Контекст, Ключ);
КонецФункции

Функция ЗабратьСообщенияЯчейкиИзКонтекста(Контекст, Ключ) Экспорт
	Сообщения = Новый Массив;
	КлючРезультата = "";
	Если Контекст.Свойство("__onec_cell_messages_result_key", КлючРезультата)
			И КлючРезультата = Ключ
			И Контекст.Свойство("__onec_cell_messages_result", Сообщения) Тогда
		Контекст.Удалить("__onec_cell_messages_result_key");
		Контекст.Удалить("__onec_cell_messages_result");
	КонецЕсли;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Сообщения);
	Возврат Запись.Закрыть();
КонецФункции

Функция ЗабратьКомпактнуюМатериализациюИзКонтекста(Контекст, Ключ) Экспорт
	Значение = Неопределено;
	Если Не Контекст.Свойство(Ключ, Значение) Тогда
		ВызватьИсключение "Компактная материализация отсутствует в контексте";
	КонецЕсли;
	Контекст.Удалить(Ключ);
	Возврат Значение;
КонецФункции

Функция УдалитьМатериализациюИзКонтекста(Контекст, Ключ) Экспорт
	Значение = Неопределено;
	Если Контекст.Свойство(Ключ, Значение) Тогда
		Контекст.Удалить(Ключ);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ВосстановитьКонтекстВыполнения(КонтекстВыполнения) Экспорт
	Контекст = RuntimeContextStoreServer.ПолучитьКонтекст();
	ПерепривязатьКонтекстВыполнения(Контекст, КонтекстВыполнения);
	Возврат Истина;
КонецФункции

Процедура ПерепривязатьКонтекстВыполнения(Контекст, КонтекстВыполнения)
	Если КонтекстВыполнения <> Неопределено Тогда
		ИдентификаторТекущегоКонтекста = Неопределено;
		Если Не КонтекстВыполнения.Свойство("__onec_runtime_context_id", ИдентификаторТекущегоКонтекста) Тогда
			ИдентификаторТекущегоКонтекста = Новый УникальныйИдентификатор;
			КонтекстВыполнения.Вставить("__onec_runtime_context_id", ИдентификаторТекущегоКонтекста);
		КонецЕсли;
		СнимокКонтекста = Новый Структура;
		Для Каждого ЭлементКонтекста Из КонтекстВыполнения Цикл
			СнимокКонтекста.Вставить(ЭлементКонтекста.Ключ, ЭлементКонтекста.Значение);
		КонецЦикла;
		Контекст.Очистить();
		Для Каждого ЭлементКонтекста Из СнимокКонтекста Цикл
			Контекст.Вставить(ЭлементКонтекста.Ключ, ЭлементКонтекста.Значение);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
