Функция СинтетическийCapture(НачальноеЗначение) Экспорт
	Скаляр = НачальноеЗначение;
	Результат = Новый Массив;
	Если Результат.Количество() = 0 Тогда // @runtime-synthetic-capture-a
		Результат.Добавить(Скаляр);
	КонецЕсли;
	Если Результат.Количество() = 1 Тогда // @runtime-synthetic-capture-b
		Скаляр = Скаляр + 1;
		Результат.Добавить(Скаляр);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура Запустить() Экспорт
	ИдентификаторПродуктаRuntime = "onec-interactive-runtime";
	ВерсияАртефактаRuntime = "0.1.11";
	ВерсияПротоколаRuntime = "5";
	e1cRuntimeКонтекст = Новый Структура; // @runtime-server-extension-entry-breakpoint
	ТекущаяИнструкция = "";
	ИдентификаторКоманды = 0;
	ЗавершеннаяКоманда = 0;
	Результат = Неопределено;
	Ошибка = "";
	Пока Истина Цикл
		С = 1; // @runtime-server-extension-service-breakpoint
		Если ИдентификаторКоманды > ЗавершеннаяКоманда Тогда
			Результат = Неопределено;
			Ошибка = "";
			Попытка
				Выполнить(ТекущаяИнструкция);
			Исключение
				Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;
			ЗавершеннаяКоманда = ИдентификаторКоманды;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Выполняет служебную инструкцию на остановленном MAIN кадре. e1cRuntimeКонтекст
// передаётся из этого кадра, без создания или чтения CAPTURE КонтекстОтладки.
Функция ВыполнитьКодВКонтекстеMain(e1cRuntimeКонтекст, Код) Экспорт
	Результат = Неопределено;
	РезультатИнструкции = Неопределено;
	Выполнить(Код);
	Возврат РезультатИнструкции;
КонецФункции

Функция НачатьКонтекстОтладкиВКонтексте(e1cRuntimeКонтекст, АдресКонтекстаОтладки) Экспорт
	КонтекстОтладки = ПолучитьИзВременногоХранилища(АдресКонтекстаОтладки);
	Если КонтекстОтладки = Неопределено Тогда
		ВызватьИсключение "e1cRuntimeКонтекст отладки отсутствует во временном хранилище";
	КонецЕсли;
	e1cRuntimeКонтекст.Вставить("КонтекстОтладки", КонтекстОтладки);
	УдалитьИзВременногоХранилища(АдресКонтекстаОтладки);
	Возврат Истина;
КонецФункции

Функция ВыполнитьКодВКонтекстеОтладки(e1cRuntimeКонтекст, Код) Экспорт
	КонтекстОтладки = Неопределено;
	Если Не e1cRuntimeКонтекст.Свойство("КонтекстОтладки", КонтекстОтладки) Тогда
		ВызватьИсключение "e1cRuntimeКонтекст отладки не инициализирован";
	КонецЕсли;
	Если e1cRuntimeКонтекст.Свойство("РезультатИнструкции") Тогда
		e1cRuntimeКонтекст.Удалить("РезультатИнструкции");
	КонецЕсли;
	РезультатИнструкции = Неопределено;
	РезультатКонтекста = Неопределено;
	__OnecPinnedWorkerGenerationOriginal = Неопределено;
	__OnecPinnedWorkerGenerationSlotExists = e1cRuntimeКонтекст.Свойство("RuntimeWorkerPinnedOperationGeneration", __OnecPinnedWorkerGenerationOriginal);
	__OnecPinnedWorkerGeneration = __OnecPinnedWorkerGenerationOriginal;
	Попытка
		Выполнить(Код);
	Исключение
		ВосстановитьПинПоколенияWorker(e1cRuntimeКонтекст, __OnecPinnedWorkerGenerationSlotExists, __OnecPinnedWorkerGenerationOriginal);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьПинПоколенияWorker(e1cRuntimeКонтекст, __OnecPinnedWorkerGenerationSlotExists, __OnecPinnedWorkerGenerationOriginal);
	Если e1cRuntimeКонтекст.Свойство("РезультатИнструкции", РезультатКонтекста) Тогда
		Возврат РезультатКонтекста;
	КонецЕсли;
	Возврат РезультатИнструкции;
КонецФункции

Процедура ВосстановитьПинПоколенияWorker(e1cRuntimeКонтекст, СлотСуществовал, ИсходноеЗначение)
	Если СлотСуществовал Тогда
		e1cRuntimeКонтекст.Вставить("RuntimeWorkerPinnedOperationGeneration", ИсходноеЗначение);
	ИначеЕсли e1cRuntimeКонтекст.Свойство("RuntimeWorkerPinnedOperationGeneration") Тогда
		e1cRuntimeКонтекст.Удалить("RuntimeWorkerPinnedOperationGeneration");
	КонецЕсли;
КонецПроцедуры

Функция УстановитьПинПоколенияWorker(e1cRuntimeКонтекст, ОжидаемыйManifestSha256) Экспорт
	АктивноеПоколениеWorker = Неопределено;
	Если Не e1cRuntimeКонтекст.Свойство("RuntimeWorkerActiveGeneration", АктивноеПоколениеWorker) Тогда
		ВызватьИсключение "Active Worker generation is missing";
	КонецЕсли;
	Если АктивноеПоколениеWorker.ManifestSha256 <> ОжидаемыйManifestSha256 Тогда
		ВызватьИсключение "Worker generation pin mismatch";
	КонецЕсли;
	e1cRuntimeКонтекст.Вставить("RuntimeWorkerPinnedOperationGeneration", АктивноеПоколениеWorker);
	Возврат Истина;
КонецФункции

Функция ОчиститьПинПоколенияWorker(e1cRuntimeКонтекст) Экспорт
	Если e1cRuntimeКонтекст.Свойство("RuntimeWorkerPinnedOperationGeneration") Тогда
		e1cRuntimeКонтекст.Удалить("RuntimeWorkerPinnedOperationGeneration");
	КонецЕсли;
	Возврат Истина;
КонецФункции

