Функция ПолучитьИменаСвойствДляПодсказки(Значение, ТабличнаяСтрока = Ложь) Экспорт
	Имена = Новый ТаблицаЗначений;
	Имена.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		ЭтоКореньWorker = Значение.Свойство("ManifestSha256")
			И Значение.Свойство("Modules") И Значение.Свойство("Exports");
		ВидКонтейнераWorker = Неопределено;
		ЭтоЭкспортыWorker = Значение.Свойство("Kind", ВидКонтейнераWorker)
			И ВидКонтейнераWorker = "OnecWorkerExportsV1" И Значение.Свойство("Items");
		Если ЭтоКореньWorker Или ЭтоЭкспортыWorker Тогда
			Возврат Имена;
		КонецЕсли;
	КонецЕсли;
	Если ТабличнаяСтрока И ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Для Каждого Колонка Из Значение.Колонки Цикл
			Имена.Добавить().Имя = Колонка.Имя;
			Если Имена.Количество() >= 128 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Не ТабличнаяСтрока И (ТипЗначения = Тип("Структура")
			Или ТипЗначения = Тип("ФиксированнаяСтруктура")) Тогда
		Для Каждого Элемент Из Значение Цикл
			Имена.Добавить().Имя = Элемент.Ключ;
			Если Имена.Количество() >= 128 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Имена;
КонецФункции

Функция ПолучитьДопущенныеИменаСвойствДляПодсказки(Значение, ТабличнаяСтрока = Ложь, РегистрацииWorker = "") Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Попытка
		ТипыОбъектовWorker = Новый Массив;
		Если РегистрацииWorker <> "" Тогда
			Для Каждого РегистрацияWorker Из СтрРазделить(РегистрацииWorker, Символы.ПС) Цикл
				ВременныйОбъектWorker = ВнешниеОбработки.Создать(РегистрацияWorker, Ложь);
				ТипыОбъектовWorker.Добавить(ТипЗнч(ВременныйОбъектWorker));
			КонецЦикла;
		КонецЕсли;
		Если Не ДопуститьЗначение(Значение, ТипыОбъектовWorker) Тогда
			Результат.Добавить().Состояние = "D|worker_generation_value";
			Возврат Результат;
		КонецЕсли;
		Результат.Добавить().Состояние = "R";
		Имена = ПолучитьИменаСвойствДляПодсказки(Значение, ТабличнаяСтрока);
		Для Каждого СтрокаИмени Из Имена Цикл
			СтрокаРезультата = Результат.Добавить();
			СтрокаРезультата.Состояние = "R";
			СтрокаРезультата.Имя = СтрокаИмени.Имя;
		КонецЦикла;
	Исключение
		Результат.Очистить();
		Результат.Добавить().Состояние = "E|value_admission_failed";
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция СериализоватьДопущенныеИменаСвойствДляПодсказки(Значение, ТабличнаяСтрока = Ложь, РегистрацииWorker = "") Экспорт
	СхемаПодсказки = ПолучитьДопущенныеИменаСвойствДляПодсказки(
		Значение, ТабличнаяСтрока, РегистрацииWorker);
	Результат = "C" + Символы.Таб + Формат(СхемаПодсказки.Количество(), "ЧГ=0; ЧДЦ=0");
	Для Каждого СтрокаПодсказки Из СхемаПодсказки Цикл
		Результат = Результат + Символы.ПС + СтрокаПодсказки.Состояние
			+ Символы.Таб + СтрокаПодсказки.Имя;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьВидМатериализации(Значение) Экспорт
	ТипЗначения = ТипЗнч(Значение);
	МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ЭтоТабличноеЗначение(Значение, ТипЗначения, МетаданныеЗначения) Тогда
		Возврат "table";
	КонецЕсли;
	Возврат "value";
КонецФункции

Функция ДопуститьЗначение(Значение, ТипыОбъектовWorker) Экспорт
	Возврат Не ЭтоПриватноеЗначениеWorker(Значение, ТипыОбъектовWorker);
КонецФункции

// Закрытая проекция для capture.context и capture.stack.native[].variables.
// Корни и путь создаются вызывающим кодом только из проверенных идентификаторов.
// Здесь каждый опубликованный корень/потомок допускается до чтения типа,
// представления или состава контейнера. Ошибка отдельного элемента даёт
// name-only unavailable; ошибка запроса поднимается вызывающему коду как
// bounded E|value_admission_failed.
Функция СпроецироватьЗначенияИнспекции(Корни, Путь, Действие, Вид, Старт, Стоп, Роль, Параметры, Точное, ТипыОбъектовWorker, ЛимитКолонок, МаксимумЭлементов, МаксимумБайт) Экспорт
	Если Старт < 0 Или Стоп < Старт Или Стоп - Старт > МаксимумЭлементов Или МаксимумБайт <= 0 Тогда
		ВызватьИсключение "Недопустимые ограничения проекции значений";
	КонецЕсли;
	Если Не ДопуститьЗначение(Корни, ТипыОбъектовWorker) Тогда
		Возврат Новый Структура("Доступ", Ложь);
	КонецЕсли;

	Разрешение = РазрешитьПутьИнспекции(Корни, Путь, ТипыОбъектовWorker);
	Если Не Разрешение.Доступ Тогда
		Возврат Новый Структура("Доступ", Ложь);
	КонецЕсли;
	Значение = Разрешение.Значение;

	Если Действие = "resolve" Тогда
		Документ = Новый Структура;
		Документ.Вставить("v", 1);
		Документ.Вставить("action", "resolve");
		Документ.Вставить("entry", ЗаписьЗначенияИнспекции(Разрешение.Имя, Значение, ТипыОбъектовWorker, Разрешение.Предки));
		Возврат ЗавершитьДокументИнспекции(Документ, МаксимумБайт);
	КонецЕсли;

	Если Действие = "columns" Тогда
		Если ЛимитКолонок <= 0 Тогда
			ВызватьИсключение "Схема значения недоступна";
		КонецЕсли;
		ТипЗначения = ТипЗнч(Значение);
		Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
			ИсточникКолонок = Значение.Колонки;
		ИначеЕсли ЭтоСтрокаТаблицыИнспекции(ТипЗначения) Тогда
			ИсточникКолонок = Значение.Владелец().Колонки;
		Иначе
			ВызватьИсключение "Схема значения недоступна";
		КонецЕсли;
		Колонки = Новый Массив;
		Для Каждого Колонка Из ИсточникКолонок Цикл
			Если Колонки.Количество() >= ЛимитКолонок Тогда
				Прервать;
			КонецЕсли;
			Колонки.Добавить(Колонка.Имя);
		КонецЦикла;
		Документ = Новый Структура;
		Документ.Вставить("v", 1);
		Документ.Вставить("action", "columns");
		Документ.Вставить("columns", Колонки);
		Возврат ЗавершитьДокументИнспекции(Документ, МаксимумБайт);
	КонецЕсли;

	Если Действие <> "project" Тогда
		ВызватьИсключение "Неизвестное действие проекции значений";
	КонецЕсли;
	Разрешение.Предки.Добавить(Значение);
	СтраницаИмен = СтраницаИменПроекцииИнспекции(
		Значение, Вид, Роль, Параметры, Точное, Старт, Стоп, ЛимитКолонок);
	Записи = Новый Массив;
	Для Каждого Имя Из СтраницаИмен.Имена Цикл
		Если Вид = "table_columns" Тогда
			Записи.Добавить(ЗаписьКолонкиИнспекции(Имя));
		Иначе
			Попытка
				Потомок = ЗначениеПоИмениПроекцииИнспекции(Значение, Вид, Имя);
				Записи.Добавить(ЗаписьЗначенияИнспекции(Имя, Потомок, ТипыОбъектовWorker, Разрешение.Предки));
			Исключение
				Записи.Добавить(Новый Структура("name,unavailable", Имя, Истина));
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Документ = Новый Структура;
	Документ.Вставить("v", 1);
	Документ.Вставить("action", "project");
	Документ.Вставить("entries", Записи);
	Документ.Вставить("total", СтраницаИмен.Количество);
	Документ.Вставить("next", СтраницаИмен.Следующий);
	Возврат ЗавершитьДокументИнспекции(Документ, МаксимумБайт);
КонецФункции

// Один результат evalExpr для инспекции остановленного кадра. ЗапросJSON содержит
// только проверенные селекторы и бюджеты; значения приходят отдельным аргументом
// из того же frame. Данные не публикуются в RuntimeContextStoreServer.
Функция СериализоватьИнспекциюДляОтладки(Корни, ЗапросJSON) Экспорт
	Попытка
		Если ТипЗнч(ЗапросJSON) <> Тип("Строка") Или СтрДлина(ЗапросJSON) = 0 Или СтрДлина(ЗапросJSON) > 65536 Тогда
			ВызватьИсключение "Недопустимый запрос инспекции";
		КонецЕсли;
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ЗапросJSON);
		Запрос = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
		ПроверитьЗапросИнспекцииДляОтладки(Запрос);
		Если Запрос.exact = Null Тогда
			Запрос.exact = Неопределено;
		КонецЕсли;

		ТипыОбъектовWorker = Новый Массив;
		Для Каждого РегистрацияWorker Из Запрос.registrations Цикл
			ОбъектWorker = ВнешниеОбработки.Создать(РегистрацияWorker, Ложь);
			ТипыОбъектовWorker.Добавить(ТипЗнч(ОбъектWorker));
		КонецЦикла;
		Проекция = СпроецироватьЗначенияИнспекции(
			Корни, Запрос.path, Запрос.action, Запрос.view, Запрос.start,
			Запрос.stop, Запрос.role, Запрос.parameters, Запрос.exact,
			ТипыОбъектовWorker, Запрос.column_limit, Запрос.max_items, Запрос.max_bytes);
		Если Не Проекция.Доступ Тогда
			Возврат "D|worker_generation_value";
		КонецЕсли;
		Если Проекция.Размер <= 0 Или Проекция.Размер > Запрос.max_bytes
			Или СтрДлина(Проекция.Хеш) <> 64
			Или СтрДлина(Проекция.Base64) <> 4 * Цел((Проекция.Размер + 2) / 3) Тогда
			ВызватьИсключение "Недопустимый размер проекции";
		КонецЕсли;
		Возврат "R|" + Формат(Запрос.runtime_generation, "ЧГ=0; ЧДЦ=0") + "|"
			+ Формат(Запрос.context_generation, "ЧГ=0; ЧДЦ=0") + "|"
			+ Формат(Проекция.Размер, "ЧГ=0; ЧДЦ=0") + "|"
			+ Проекция.Хеш + "|"
			+ Формат(СтрДлина(Проекция.Base64), "ЧГ=0; ЧДЦ=0") + "|"
			+ Проекция.Base64;
	Исключение
		Возврат "E|value_admission_failed";
	КонецПопытки;
КонецФункции

Процедура ПроверитьЗапросИнспекцииДляОтладки(Запрос)
	Если ТипЗнч(Запрос) <> Тип("Структура") Тогда
		ВызватьИсключение "Недопустимая форма запроса инспекции";
	КонецЕсли;
	Если Запрос.Количество() <> 14
		Или Не Запрос.Свойство("action") Или Не Запрос.Свойство("path")
		Или Не Запрос.Свойство("view") Или Не Запрос.Свойство("start")
		Или Не Запрос.Свойство("stop") Или Не Запрос.Свойство("role")
		Или Не Запрос.Свойство("parameters") Или Не Запрос.Свойство("exact")
		Или Не Запрос.Свойство("registrations") Или Не Запрос.Свойство("column_limit")
		Или Не Запрос.Свойство("max_items") Или Не Запрос.Свойство("max_bytes")
		Или Не Запрос.Свойство("runtime_generation")
		Или Не Запрос.Свойство("context_generation") Тогда
		ВызватьИсключение "Недопустимые поля запроса инспекции";
	КонецЕсли;
	Если ТипЗнч(Запрос.action) <> Тип("Строка") Или ТипЗнч(Запрос.view) <> Тип("Строка")
		Или ТипЗнч(Запрос.role) <> Тип("Строка") Тогда
		ВызватьИсключение "Недопустимый маршрут инспекции";
	КонецЕсли;
	Если Запрос.action <> "project" И Запрос.action <> "resolve" И Запрос.action <> "columns" Тогда
		ВызватьИсключение "Недопустимое действие инспекции";
	КонецЕсли;
	Если Запрос.role <> "variables" И Запрос.role <> "parameters" И Запрос.role <> "locals" Тогда
		ВызватьИсключение "Недопустимая роль инспекции";
	КонецЕсли;
	Если Запрос.view <> "" И Запрос.view <> "variables"
		И Запрос.view <> "structure_fields" И Запрос.view <> "array_items"
		И Запрос.view <> "table_columns" И Запрос.view <> "table_rows"
		И Запрос.view <> "row_fields" Тогда
		ВызватьИсключение "Недопустимый вид инспекции";
	КонецЕсли;
	Если ТипЗнч(Запрос.path) <> Тип("Массив") Или Запрос.path.Количество() > 17
		Или ТипЗнч(Запрос.parameters) <> Тип("Массив") Или Запрос.parameters.Количество() > 100
		Или ТипЗнч(Запрос.registrations) <> Тип("Массив") Или Запрос.registrations.Количество() > 32 Тогда
		ВызватьИсключение "Недопустимые коллекции запроса инспекции";
	КонецЕсли;
	ПроверитьЧислоЗапросаИнспекции(Запрос.start, 0, 10000000);
	ПроверитьЧислоЗапросаИнспекции(Запрос.stop, 0, 10000000);
	ПроверитьЧислоЗапросаИнспекции(Запрос.column_limit, 1, 101);
	ПроверитьЧислоЗапросаИнспекции(Запрос.max_items, 1, 100);
	ПроверитьЧислоЗапросаИнспекции(Запрос.max_bytes, 1, 65536);
	ПроверитьЧислоЗапросаИнспекции(Запрос.runtime_generation, 1, 9223372036854775807);
	ПроверитьЧислоЗапросаИнспекции(Запрос.context_generation, 1, 9223372036854775807);
	Если Запрос.max_items > 100 Или Запрос.max_bytes > 65536 Или Запрос.column_limit > 101
		Или Запрос.stop < Запрос.start Или Запрос.stop - Запрос.start > Запрос.max_items Тогда
		ВызватьИсключение "Превышен бюджет запроса инспекции";
	КонецЕсли;
	Если Запрос.exact <> Неопределено И Запрос.exact <> Null Тогда
		Если ТипЗнч(Запрос.exact) = Тип("Строка") Тогда
			Если СтрДлина(Запрос.exact) = 0 Или СтрДлина(Запрос.exact) > 256 Тогда
				ВызватьИсключение "Недопустимый точный селектор инспекции";
			КонецЕсли;
		Иначе
			ПроверитьЧислоЗапросаИнспекции(Запрос.exact, 0, 10000000);
		КонецЕсли;
	КонецЕсли;
	Для Каждого Параметр Из Запрос.parameters Цикл
		Если ТипЗнч(Параметр) <> Тип("Строка") Тогда
			ВызватьИсключение "Недопустимый параметр инспекции";
		КонецЕсли;
		Если СтрДлина(Параметр) = 0 Или СтрДлина(Параметр) > 256 Тогда
			ВызватьИсключение "Недопустимый параметр инспекции";
		КонецЕсли;
	КонецЦикла;
	Для Каждого РегистрацияWorker Из Запрос.registrations Цикл
		Если ТипЗнч(РегистрацияWorker) <> Тип("Строка") Тогда
			ВызватьИсключение "Недопустимая регистрация Worker";
		КонецЕсли;
		Если СтрДлина(РегистрацияWorker) = 0 Или СтрДлина(РегистрацияWorker) > 4096 Тогда
			ВызватьИсключение "Недопустимая регистрация Worker";
		КонецЕсли;
	КонецЦикла;
	Для НомерСегмента = 0 По Запрос.path.Количество() - 1 Цикл
		Сегмент = Запрос.path[НомерСегмента];
		Если ТипЗнч(Сегмент) <> Тип("Структура") Тогда
			ВызватьИсключение "Недопустимый сегмент пути инспекции";
		КонецЕсли;
		Если Сегмент.Количество() <> 2 Или Не Сегмент.Свойство("kind") Или Не Сегмент.Свойство("key")
			Или ТипЗнч(Сегмент.kind) <> Тип("Строка") Тогда
			ВызватьИсключение "Недопустимый сегмент пути инспекции";
		КонецЕсли;
		Если НомерСегмента = 0 И Сегмент.kind <> "variable" Тогда
			ВызватьИсключение "Недопустимый корень пути инспекции";
		КонецЕсли;
		Если НомерСегмента > 0 И Сегмент.kind <> "field"
			И Сегмент.kind <> "index" И Сегмент.kind <> "row" Тогда
			ВызватьИсключение "Недопустимый потомок пути инспекции";
		КонецЕсли;
		Если Сегмент.kind = "variable" Или Сегмент.kind = "field" Тогда
			Если ТипЗнч(Сегмент.key) <> Тип("Строка") Тогда
				ВызватьИсключение "Недопустимое имя пути инспекции";
			КонецЕсли;
			Если СтрДлина(Сегмент.key) = 0 Или СтрДлина(Сегмент.key) > 256 Тогда
				ВызватьИсключение "Недопустимое имя пути инспекции";
			КонецЕсли;
		Иначе
			ПроверитьЧислоЗапросаИнспекции(Сегмент.key, 0, 10000000);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьЧислоЗапросаИнспекции(Значение, Минимум, Максимум)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение "Недопустимое число запроса инспекции";
	КонецЕсли;
	Если Значение <> Цел(Значение) Или Значение < Минимум Или Значение > Максимум Тогда
		ВызватьИсключение "Недопустимое число запроса инспекции";
	КонецЕсли;
КонецПроцедуры

Функция РазрешитьПутьИнспекции(Корни, Путь, ТипыОбъектовWorker)
	ТекущееЗначение = Корни;
	ИмяТекущегоЗначения = "";
	Предки = Новый Массив;
	Для Каждого Сегмент Из Путь Цикл
		Если Не ДопуститьЗначение(ТекущееЗначение, ТипыОбъектовWorker) Тогда
			Возврат Новый Структура("Доступ", Ложь);
		КонецЕсли;
		Предки.Добавить(ТекущееЗначение);
		ВидСегмента = Сегмент.kind;
		КлючСегмента = Сегмент.key;
		ТипТекущегоЗначения = ТипЗнч(ТекущееЗначение);
		Если ВидСегмента = "variable" Или ВидСегмента = "field" Тогда
			Если Не ЭтоСтруктураИнспекции(ТипТекущегоЗначения) И Не ЭтоСтрокаТаблицыИнспекции(ТипТекущегоЗначения) Тогда
				ВызватьИсключение "Поле значения недоступно";
			КонецЕсли;
			Если ЭтоСтруктураИнспекции(ТипТекущегоЗначения) Тогда
				ИмяСвойства = НайтиИмяСтруктурыИнспекции(ТекущееЗначение, КлючСегмента);
				Если ИмяСвойства = Неопределено Тогда
					ВызватьИсключение "Поле значения не найдено";
				КонецЕсли;
				СледующееЗначение = Неопределено;
				ТекущееЗначение.Свойство(ИмяСвойства, СледующееЗначение);
				ТекущееЗначение = СледующееЗначение;
				ИмяТекущегоЗначения = ИмяСвойства;
			Иначе
				ИмяКолонки = НайтиИмяКолонкиСтрокиИнспекции(ТекущееЗначение, КлючСегмента);
				Если ИмяКолонки = Неопределено Тогда
					ВызватьИсключение "Поле строки не найдено";
				КонецЕсли;
				ТекущееЗначение = ТекущееЗначение[ИмяКолонки];
				ИмяТекущегоЗначения = ИмяКолонки;
			КонецЕсли;
		ИначеЕсли ВидСегмента = "index" Тогда
			Если Не ЭтоМассивИнспекции(ТипТекущегоЗначения) Или ТипЗнч(КлючСегмента) <> Тип("Число") Или КлючСегмента < 0 Или КлючСегмента >= ТекущееЗначение.Количество() Тогда
				ВызватьИсключение "Индекс значения недоступен";
			КонецЕсли;
			ТекущееЗначение = ТекущееЗначение[КлючСегмента];
			ИмяТекущегоЗначения = КлючСегмента;
		ИначеЕсли ВидСегмента = "row" Тогда
			Если ТипТекущегоЗначения <> Тип("ТаблицаЗначений") Или ТипЗнч(КлючСегмента) <> Тип("Число") Или КлючСегмента < 0 Или КлючСегмента >= ТекущееЗначение.Количество() Тогда
				ВызватьИсключение "Строка таблицы недоступна";
			КонецЕсли;
			ТекущееЗначение = ТекущееЗначение[КлючСегмента];
			ИмяТекущегоЗначения = КлючСегмента;
		Иначе
			ВызватьИсключение "Сегмент пути значения недопустим";
		КонецЕсли;
	КонецЦикла;
	Если Не ДопуститьЗначение(ТекущееЗначение, ТипыОбъектовWorker) Тогда
		Возврат Новый Структура("Доступ", Ложь);
	КонецЕсли;
	Возврат Новый Структура("Доступ,Значение,Имя,Предки", Истина, ТекущееЗначение, ИмяТекущегоЗначения, Предки);
КонецФункции

Функция СтраницаИменПроекцииИнспекции(Значение, Вид, Роль, Параметры, Точное, Старт, Стоп, ЛимитКолонок)
	ТипЗначения = ТипЗнч(Значение);
	Если Вид = "variables" Или Вид = "structure_fields" Тогда
		Если Не ЭтоСтруктураИнспекции(ТипЗначения) Тогда
			ВызватьИсключение "Поля значения недоступны";
		КонецЕсли;
		Возврат СтраницаСтруктурыИнспекции(Значение, Роль, Параметры, Точное, Старт, Стоп);
	КонецЕсли;
	Если Вид = "array_items" Тогда
		Если Не ЭтоМассивИнспекции(ТипЗначения) Тогда
			ВызватьИсключение "Элементы значения недоступны";
		КонецЕсли;
		Возврат СтраницаИндексовИнспекции(Значение.Количество(), Точное, Старт, Стоп);
	КонецЕсли;
	Если Вид = "table_rows" Тогда
		Если ТипЗначения <> Тип("ТаблицаЗначений") Тогда
			ВызватьИсключение "Строки таблицы недоступны";
		КонецЕсли;
		Если ЛимитКолонок <= 0 Или Значение.Колонки.Количество() >= ЛимитКолонок Тогда
			ВызватьИсключение "Таблица значений превышает допустимую ширину";
		КонецЕсли;
		Возврат СтраницаИндексовИнспекции(Значение.Количество(), Точное, Старт, Стоп);
	КонецЕсли;
	Если Вид = "table_columns" Тогда
		Если ТипЗначения <> Тип("ТаблицаЗначений") Тогда
			ВызватьИсключение "Колонки таблицы недоступны";
		КонецЕсли;
		Возврат СтраницаКолонокИнспекции(Значение.Колонки, Точное, Старт, Стоп);
	КонецЕсли;
	Если Вид = "row_fields" Тогда
		Если Не ЭтоСтрокаТаблицыИнспекции(ТипЗначения) Тогда
			ВызватьИсключение "Поля строки недоступны";
		КонецЕсли;
		Возврат СтраницаКолонокИнспекции(Значение.Владелец().Колонки, Точное, Старт, Стоп);
	КонецЕсли;
	ВызватьИсключение "Вид проекции значения недопустим";
КонецФункции

Функция СтраницаСтруктурыИнспекции(Значение, Роль, Параметры, Точное, Старт, Стоп)
	Если Роль = "parameters" Тогда
		ИменаПараметров = Новый Массив;
		Для Каждого ИмяПараметра Из Параметры Цикл
			ИмяСвойства = НайтиИмяСтруктурыИнспекции(Значение, ИмяПараметра);
			Если ИмяСвойства <> Неопределено Тогда
				ИменаПараметров.Добавить(ИмяСвойства);
			КонецЕсли;
		КонецЦикла;
		Возврат СтраницаПолногоМассиваИменИнспекции(ИменаПараметров, Точное, Старт, Стоп);
	КонецЕсли;

	Если Точное <> Неопределено Тогда
		ИмяСвойства = НайтиИмяСтруктурыИнспекции(Значение, Точное);
		Если ИмяСвойства = Неопределено
			Или Роль = "locals" И ЭтоПараметрИнспекции(ИмяСвойства, Параметры) Тогда
			Возврат ЗавершитьСтраницуИменИнспекции(Новый Массив, 0, Стоп);
		КонецЕсли;
		Имена = Новый Массив;
		Если Старт = 0 И Стоп > 0 Тогда
			Имена.Добавить(ИмяСвойства);
		КонецЕсли;
		Возврат ЗавершитьСтраницуИменИнспекции(Имена, 1, Стоп);
	КонецЕсли;

	Количество = Значение.Количество();
	Если Роль = "locals" Тогда
		Для Каждого ИмяПараметра Из Параметры Цикл
			Если НайтиИмяСтруктурыИнспекции(Значение, ИмяПараметра) <> Неопределено Тогда
				Количество = Количество - 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ПроверитьКоличествоИнспекции(Количество);
	Имена = Новый Массив;
	Позиция = 0;
	Для Каждого Элемент Из Значение Цикл
		Если Роль = "locals" И ЭтоПараметрИнспекции(Элемент.Ключ, Параметры) Тогда
			Продолжить;
		КонецЕсли;
		Если Позиция >= Стоп Тогда
			Прервать;
		КонецЕсли;
		Если Позиция >= Старт Тогда
			Имена.Добавить(Элемент.Ключ);
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат ЗавершитьСтраницуИменИнспекции(Имена, Количество, Стоп);
КонецФункции

Функция СтраницаИндексовИнспекции(Количество, Точное, Старт, Стоп)
	ПроверитьКоличествоИнспекции(Количество);
	Имена = Новый Массив;
	Если Точное <> Неопределено Тогда
		Если ТипЗнч(Точное) = Тип("Число") И Точное >= 0 И Точное < Количество Тогда
			Если Старт = 0 И Стоп > 0 Тогда
				Имена.Добавить(Точное);
			КонецЕсли;
			Возврат ЗавершитьСтраницуИменИнспекции(Имена, 1, Стоп);
		КонецЕсли;
		Возврат ЗавершитьСтраницуИменИнспекции(Имена, 0, Стоп);
	КонецЕсли;
	Если Старт < Стоп И Старт < Количество Тогда
		ПоследнийИндекс = Мин(Стоп - 1, Количество - 1);
		Для Индекс = Старт По ПоследнийИндекс Цикл
			Имена.Добавить(Индекс);
		КонецЦикла;
	КонецЕсли;
	Возврат ЗавершитьСтраницуИменИнспекции(Имена, Количество, Стоп);
КонецФункции

Функция СтраницаКолонокИнспекции(Колонки, Точное, Старт, Стоп)
	Количество = Колонки.Количество();
	ПроверитьКоличествоИнспекции(Количество);
	Имена = Новый Массив;
	Если Точное <> Неопределено Тогда
		Для Каждого Колонка Из Колонки Цикл
			Если ТипЗнч(Точное) = Тип("Строка") И НРег(Колонка.Имя) = НРег(Точное) Тогда
				Если Старт = 0 И Стоп > 0 Тогда
					Имена.Добавить(Колонка.Имя);
				КонецЕсли;
				Возврат ЗавершитьСтраницуИменИнспекции(Имена, 1, Стоп);
			КонецЕсли;
		КонецЦикла;
		Возврат ЗавершитьСтраницуИменИнспекции(Имена, 0, Стоп);
	КонецЕсли;
	Позиция = 0;
	Для Каждого Колонка Из Колонки Цикл
		Если Позиция >= Стоп Тогда
			Прервать;
		КонецЕсли;
		Если Позиция >= Старт Тогда
			Имена.Добавить(Колонка.Имя);
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат ЗавершитьСтраницуИменИнспекции(Имена, Количество, Стоп);
КонецФункции

Функция СтраницаПолногоМассиваИменИнспекции(Имена, Точное, Старт, Стоп)
	Если Точное <> Неопределено Тогда
		Имена = ОтфильтроватьТочныеИменаИнспекции(Имена, Точное);
	КонецЕсли;
	ПроверитьКоличествоИнспекции(Имена.Количество());
	Страница = Новый Массив;
	Если Старт < Стоп И Старт < Имена.Количество() Тогда
		ПоследнийИндекс = Мин(Стоп - 1, Имена.Количество() - 1);
		Для Индекс = Старт По ПоследнийИндекс Цикл
			Страница.Добавить(Имена[Индекс]);
		КонецЦикла;
	КонецЕсли;
	Возврат ЗавершитьСтраницуИменИнспекции(Страница, Имена.Количество(), Стоп);
КонецФункции

Функция ЗавершитьСтраницуИменИнспекции(Имена, Количество, Стоп)
	ПроверитьКоличествоИнспекции(Количество);
	Следующий = Неопределено;
	Если Стоп < Количество Тогда
		Следующий = Стоп;
	КонецЕсли;
	Возврат Новый Структура("Имена,Количество,Следующий", Имена, Количество, Следующий);
КонецФункции

Процедура ПроверитьКоличествоИнспекции(Количество)
	Если Количество < 0 Или Количество > 10000000 Тогда
		ВызватьИсключение "Слишком много элементов проекции значений";
	КонецЕсли;
КонецПроцедуры

Функция ЗначениеПоИмениПроекцииИнспекции(Значение, Вид, Имя)
	Результат = Неопределено;
	Если Вид = "variables" Или Вид = "structure_fields" Тогда
		Значение.Свойство(Имя, Результат);
		Возврат Результат;
	КонецЕсли;
	Если Вид = "array_items" Или Вид = "table_rows" Тогда
		Возврат Значение[Имя];
	КонецЕсли;
	Если Вид = "row_fields" Тогда
		Возврат Значение[Имя];
	КонецЕсли;
	ВызватьИсключение "Значение проекции недоступно";
КонецФункции

Функция ОтфильтроватьТочныеИменаИнспекции(Имена, Точное)
	Результат = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Если ТипЗнч(Имя) = Тип("Строка") И ТипЗнч(Точное) = Тип("Строка") И НРег(Имя) = НРег(Точное) Тогда
			Результат.Добавить(Имя);
		ИначеЕсли ТипЗнч(Имя) = Тип("Число") И ТипЗнч(Точное) = Тип("Число") И Имя = Точное Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗаписьЗначенияИнспекции(Имя, Значение, ТипыОбъектовWorker, Предки = Неопределено)
	Попытка
		Если Не ДопуститьЗначение(Значение, ТипыОбъектовWorker) Тогда
			Возврат Новый Структура("name,denied", Имя, Истина);
		КонецЕсли;
		ОбнаруженЦикл = ЭтоЦиклИнспекции(Значение, Предки);
		Описание = ОписаниеЗначенияИнспекции(Значение);
		Результат = Новый Структура;
		Результат.Вставить("name", Имя);
		Результат.Вставить("denied", Ложь);
		Результат.Вставить("type_name", Описание.type_name);
		Результат.Вставить("preview", Описание.preview);
		Результат.Вставить("size", Описание.size);
		Результат.Вставить("shape", Описание.shape);
		Результат.Вставить("cycle", ОбнаруженЦикл);
		Возврат Результат;
	Исключение
		Возврат Новый Структура("name,unavailable", Имя, Истина);
	КонецПопытки;
КонецФункции

Функция ЭтоЦиклИнспекции(Значение, Предки)
	Если Предки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если Не ЭтоКонтейнерИнспекции(ТипЗначения) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Предок Из Предки Цикл
		Если ТипЗнч(Предок) = ТипЗначения И Предок = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЭтоКонтейнерИнспекции(ТипЗначения)
	Возврат ЭтоСтруктураИнспекции(ТипЗначения)
		Или ЭтоМассивИнспекции(ТипЗначения)
		Или ТипЗначения = Тип("ТаблицаЗначений")
		Или ЭтоСтрокаТаблицыИнспекции(ТипЗначения);
КонецФункции

Функция ЗаписьКолонкиИнспекции(Имя)
	Возврат Новый Структура("name,denied,type_name,preview,size,shape,cycle", Имя, Ложь, "КолонкаТаблицыЗначений", Имя, Неопределено, "column", Ложь);
КонецФункции

Функция ОписаниеЗначенияИнспекции(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Результат = Новый Структура;
	Результат.Вставить("type_name", Строка(ТипЗначения));
	Если ТипЗначения = Тип("Структура") Тогда
		Результат.Вставить("preview", "");
		Результат.Вставить("size", Значение.Количество());
		Результат.Вставить("shape", "structure");
	ИначеЕсли ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат.Вставить("preview", "");
		Результат.Вставить("size", Значение.Количество());
		Результат.Вставить("shape", "fixed_structure");
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Результат.Вставить("preview", "");
		Результат.Вставить("size", Значение.Количество());
		Результат.Вставить("shape", "array");
	ИначеЕсли ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат.Вставить("preview", "");
		Результат.Вставить("size", Значение.Количество());
		Результат.Вставить("shape", "fixed_array");
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат.Вставить("preview", "");
		Результат.Вставить("size", Значение.Количество());
		Результат.Вставить("shape", "value_table");
	ИначеЕсли ЭтоСтрокаТаблицыИнспекции(ТипЗначения) Тогда
		Результат.Вставить("preview", "");
		Результат.Вставить("size", Значение.Владелец().Колонки.Количество());
		Результат.Вставить("shape", "value_table_row");
	ИначеЕсли ЭтоБезопасныйСкалярИнспекции(ТипЗначения) Тогда
		Результат.Вставить("preview", ПредставлениеСкалярногоЗначенияИнспекции(Значение, ТипЗначения));
		Результат.Вставить("size", Неопределено);
		Результат.Вставить("shape", "scalar");
	Иначе
		ВызватьИсключение "Тип значения не поддерживается проекцией";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЭтоСтруктураИнспекции(ТипЗначения)
	Возврат ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура");
КонецФункции

Функция ЭтоМассивИнспекции(ТипЗначения)
	Возврат ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив");
КонецФункции

Функция ЭтоСтрокаТаблицыИнспекции(ТипЗначения)
	Возврат ТипЗначения = Тип("СтрокаТаблицыЗначений");
КонецФункции

Функция ЭтоБезопасныйСкалярИнспекции(ТипЗначения)
	Возврат ТипЗначения = Тип("Неопределено")
		Или ТипЗначения = Тип("Null")
		Или ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("УникальныйИдентификатор")
		Или Тип("ДвоичныеДанные") = ТипЗначения;
КонецФункции

Функция ПредставлениеСкалярногоЗначенияИнспекции(Значение, ТипЗначения)
	Если ТипЗначения <> Тип("ДвоичныеДанные") Тогда
		Возврат Лев(Строка(Значение), 512);
	КонецЕсли;
	Возврат "<binary>";
КонецФункции

Функция НайтиИмяСтруктурыИнспекции(Значение, ИскомоеИмя)
	Если ТипЗнч(ИскомоеИмя) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Элемент Из Значение Цикл
		Если НРег(Элемент.Ключ) = НРег(ИскомоеИмя) Тогда
			Возврат Элемент.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция НайтиИмяКолонкиСтрокиИнспекции(СтрокаТаблицы, ИскомоеИмя)
	Если ТипЗнч(ИскомоеИмя) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Колонка Из СтрокаТаблицы.Владелец().Колонки Цикл
		Если НРег(Колонка.Имя) = НРег(ИскомоеИмя) Тогда
			Возврат Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ЭтоПараметрИнспекции(Имя, Параметры)
	Для Каждого Параметр Из Параметры Цикл
		Если НРег(Имя) = НРег(Параметр) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЗавершитьДокументИнспекции(Документ, МаксимумБайт)
	ТекстJSON = ВJSON(Документ);
	ДанныеJSON = ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON, КодировкаТекста.UTF8, Ложь);
	Если ДанныеJSON.Размер() <= 0 Или ДанныеJSON.Размер() > МаксимумБайт Тогда
		ВызватьИсключение "Превышен размер проекции значений";
	КонецЕсли;
	Возврат Новый Структура("Доступ,Base64,Размер,Хеш", Истина, Base64БезРазрывов(ДанныеJSON), ДанныеJSON.Размер(), SHA256(ДанныеJSON));
КонецФункции

Функция ЭтоТабличноеЗначение(Значение, ТипЗначения, МетаданныеЗначения)
	Если ТипЗначения = Тип("ТаблицаЗначений")
			Или ТипЗначения = Тип("РезультатЗапроса") Тогда
		Возврат Истина;
	КонецЕсли;
	Если МетаданныеЗначения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ПолноеИмя = МетаданныеЗначения.ПолноеИмя();
	Если СтрНайти(ПолноеИмя, ".ТабличнаяЧасть.") > 0
			Или СтрНайти(ПолноеИмя, ".НаборЗаписей") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		ИмяXMLТипа = XMLТипЗнч(Значение).ИмяТипа;
		Возврат СтрНайти(ИмяXMLТипа, "RecordSet.") > 0
			Или СтрНайти(ИмяXMLТипа, "TabularSection.") > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция СериализоватьЗначение(Значение, РежимСсылок, МаксимальнаяГлубина, МаксимумЭлементов, МаксимумБайт, ТипыОбъектовWorker) Экспорт
	ПроверитьПараметры(РежимСсылок, МаксимальнаяГлубина, МаксимумЭлементов, МаксимумБайт);
	КонтекстСериализации = Новый Структура;
	КонтекстСериализации.Вставить("РежимСсылок", РежимСсылок);
	КонтекстСериализации.Вставить("МаксимальнаяГлубина", МаксимальнаяГлубина);
	КонтекстСериализации.Вставить("МаксимумЭлементов", МаксимумЭлементов);
	КонтекстСериализации.Вставить("КоличествоЭлементов", 0);
	КонтекстСериализации.Вставить("МаксимумБайт", МаксимумБайт);
	КонтекстСериализации.Вставить("КоличествоБайтОценка", 0);
	КонтекстСериализации.Вставить("АктивныеЗначения", Новый Массив);
	КонтекстСериализации.Вставить("АктивныеПути", Новый Массив);
	КонтекстСериализации.Вставить("ТипыОбъектовWorker", ТипыОбъектовWorker);
	КонтекстСериализации.Вставить("ОтказДоступа", Ложь);

	Корень = КодироватьЗначение(Значение, "$", 0, КонтекстСериализации);
	Если КонтекстСериализации.ОтказДоступа Тогда
		Возврат Новый Структура("Доступ", Ложь);
	КонецЕсли;
	Документ = Новый Структура;
	Документ.Вставить("version", 1);
	Если ЭтоОшибка(Корень) Тогда
		Документ.Вставить("error", ДокументОшибки(Корень));
	Иначе
		Документ.Вставить("root", Корень);
	КонецЕсли;
	ТекстJSON = ВJSON(Документ);
	ДанныеJSON = ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON, КодировкаТекста.UTF8, Ложь);
	Если ДанныеJSON.Размер() > МаксимумБайт Тогда
		ОшибкаРазмера = СоздатьОшибку("byte_limit", "$", МаксимумБайт);
		Документ = Новый Структура;
		Документ.Вставить("version", 1);
		Документ.Вставить("error", ДокументОшибки(ОшибкаРазмера));
		ТекстJSON = ВJSON(Документ);
		ДанныеJSON = ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON, КодировкаТекста.UTF8, Ложь);
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Доступ", Истина);
	Результат.Вставить("Base64", Base64БезРазрывов(ДанныеJSON));
	Результат.Вставить("Размер", ДанныеJSON.Размер());
	Результат.Вставить("Хеш", SHA256(ДанныеJSON));
	Результат.Вставить("КорневойВид", ПолучитьВидМатериализации(Значение));
	Возврат Результат;
КонецФункции

Процедура ПроверитьПараметры(РежимСсылок, МаксимальнаяГлубина, МаксимумЭлементов, МаксимумБайт)
	Если РежимСсылок <> "presentation" И РежимСсылок <> "uuid" И РежимСсылок <> "both" Тогда
		ВызватьИсключение "Неизвестный режим ссылок";
	КонецЕсли;
	Если МаксимальнаяГлубина <= 0 Или МаксимумЭлементов <= 0 Или МаксимумБайт <= 0 Тогда
		ВызватьИсключение "Ограничения материализации должны быть положительными";
	КонецЕсли;
КонецПроцедуры

Функция КодироватьЗначение(Значение, Путь, Глубина, КонтекстСериализации)
	Если ЭтоПриватноеЗначениеWorker(Значение, КонтекстСериализации.ТипыОбъектовWorker) Тогда
		КонтекстСериализации.ОтказДоступа = Истина;
		Возврат Неопределено;
	КонецЕсли;
	Если Глубина > КонтекстСериализации.МаксимальнаяГлубина Тогда
		Возврат СоздатьОшибку("depth_limit", Путь, КонтекстСериализации.МаксимальнаяГлубина);
	КонецЕсли;
	ОшибкаБайт = УчестьБайты(256, Путь, КонтекстСериализации);
	Если ОшибкаБайт <> Неопределено Тогда
		Возврат ОшибкаБайт;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат УзелБезЗначения("undefined");
	ИначеЕсли Значение = NULL Тогда
		Возврат УзелБезЗначения("null");
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ТипЗначения = Тип("Строка") Тогда
		ОшибкаБайт = УчестьСтроку(Значение, Путь, КонтекстСериализации);
		Если ОшибкаБайт <> Неопределено Тогда
			Возврат ОшибкаБайт;
		КонецЕсли;
		Возврат УзелСоЗначением("string", Значение);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат УзелСоЗначением("boolean", Значение);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат УзелСоЗначением("number", XMLСтрока(Значение));
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат УзелСоЗначением("datetime", XMLСтрока(Значение));
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат УзелСоЗначением("uuid", Строка(Значение));
	ИначеЕсли ТипЗначения = Тип("ДвоичныеДанные") Тогда
		РазмерBase64 = Цел((Значение.Размер() + 2) / 3) * 4;
		ОшибкаБайт = УчестьБайты(РазмерBase64, Путь, КонтекстСериализации);
		Если ОшибкаБайт <> Неопределено Тогда
			Возврат ОшибкаБайт;
		КонецЕсли;
		Возврат УзелСоЗначением("binary", Base64БезРазрывов(Значение));
	ИначеЕсли ЭтоСсылка(Значение, МетаданныеОбъекта) Тогда
		Возврат КодироватьСсылку(Значение, МетаданныеОбъекта, Путь, КонтекстСериализации);
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат КодироватьМассив(Значение, Путь, Глубина, КонтекстСериализации, "array");
	ИначеЕсли ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Возврат КодироватьМассив(Значение, Путь, Глубина, КонтекстСериализации, "fixed_array");
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Возврат КодироватьСтруктуру(Значение, Путь, Глубина, КонтекстСериализации);
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Возврат КодироватьСоответствие(Значение, Путь, Глубина, КонтекстСериализации);
	ИначеЕсли ТипЗначения = Тип("ДеревоЗначений") Тогда
		Возврат КодироватьДерево(Значение, Путь, Глубина, КонтекстСериализации);
	ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Возврат СоздатьОшибку("unsupported", Путь, Строка(ТипЗначения));
	КонецЕсли;

	Если МетаданныеОбъекта <> Неопределено Тогда
		Если СтрНачинаетсяС(МетаданныеОбъекта.ПолноеИмя(), "Перечисление.") Тогда
			Возврат КодироватьПеречисление(Значение, МетаданныеОбъекта, Путь, КонтекстСериализации);
		ИначеЕсли ЭтоОбъектМетаданных(МетаданныеОбъекта.ПолноеИмя())
				И ЭтоОбъектМетаданныхЗначение(Значение, МетаданныеОбъекта) Тогда
			Возврат КодироватьОбъект(Значение, МетаданныеОбъекта, Путь, Глубина, КонтекстСериализации);
		КонецЕсли;
	КонецЕсли;
	Возврат СоздатьОшибку("unsupported", Путь, Строка(ТипЗначения));
КонецФункции

Функция ЭтоПриватноеЗначениеWorker(Значение, ТипыОбъектовWorker)
	Если ТипыОбъектовWorker.Найти(ТипЗнч(Значение)) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		ЭтоКореньWorker = Значение.Свойство("ManifestSha256")
			И Значение.Свойство("Modules") И Значение.Свойство("Exports");
		ВидКонтейнераWorker = Неопределено;
		ЭтоЭкспортыWorker = Значение.Свойство("Kind", ВидКонтейнераWorker)
			И ВидКонтейнераWorker = "OnecWorkerExportsV1" И Значение.Свойство("Items");
		Возврат ЭтоКореньWorker Или ЭтоЭкспортыWorker;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого ЭлементWorker Из Значение Цикл
			Если ТипыОбъектовWorker.Найти(ТипЗнч(ЭлементWorker.Значение)) <> Неопределено Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция КодироватьМассив(Значение, Путь, Глубина, КонтекстСериализации, Тег)
	ОшибкаЦикла = ВойтиВКонтейнер(Значение, Путь, КонтекстСериализации);
	Если ОшибкаЦикла <> Неопределено Тогда
		Возврат ОшибкаЦикла;
	КонецЕсли;
	Значения = Новый Массив;
	Индекс = 0;
	Для Каждого Элемент Из Значение Цикл
		ОшибкаЛимита = УчестьЭлемент(Путь + "[" + Строка(Индекс) + "]", КонтекстСериализации);
		Если ОшибкаЛимита <> Неопределено Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат ОшибкаЛимита;
		КонецЕсли;
		Узел = КодироватьЗначение(Элемент, Путь + "[" + Строка(Индекс) + "]", Глубина + 1, КонтекстСериализации);
		Если ЭтоОшибка(Узел) Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат Узел;
		КонецЕсли;
		Значения.Добавить(Узел);
		Индекс = Индекс + 1;
	КонецЦикла;
	ВыйтиИзКонтейнера(КонтекстСериализации);
	Возврат УзелСоЗначением(Тег, Значения);
КонецФункции

Функция КодироватьСтруктуру(Значение, Путь, Глубина, КонтекстСериализации)
	ОшибкаЦикла = ВойтиВКонтейнер(Значение, Путь, КонтекстСериализации);
	Если ОшибкаЦикла <> Неопределено Тогда
		Возврат ОшибкаЦикла;
	КонецЕсли;
	Пары = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		ОшибкаЛимита = УчестьСтроку(Элемент.Ключ, Путь, КонтекстСериализации);
		Если ОшибкаЛимита <> Неопределено Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат ОшибкаЛимита;
		КонецЕсли;
		ПутьЗначения = Путь + "." + Элемент.Ключ;
		ОшибкаЛимита = УчестьЭлемент(ПутьЗначения, КонтекстСериализации);
		Если ОшибкаЛимита <> Неопределено Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат ОшибкаЛимита;
		КонецЕсли;
		Узел = КодироватьЗначение(Элемент.Значение, ПутьЗначения, Глубина + 1, КонтекстСериализации);
		Если ЭтоОшибка(Узел) Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат Узел;
		КонецЕсли;
		Пара = Новый Массив;
		Пара.Добавить(Элемент.Ключ);
		Пара.Добавить(Узел);
		Пары.Добавить(Пара);
	КонецЦикла;
	ВыйтиИзКонтейнера(КонтекстСериализации);
	Возврат УзелСоЗначением("structure", Пары);
КонецФункции

Функция КодироватьСоответствие(Значение, Путь, Глубина, КонтекстСериализации)
	ОшибкаЦикла = ВойтиВКонтейнер(Значение, Путь, КонтекстСериализации);
	Если ОшибкаЦикла <> Неопределено Тогда
		Возврат ОшибкаЦикла;
	КонецЕсли;
	Пары = Новый Массив;
	Индекс = 0;
	Для Каждого Элемент Из Значение Цикл
		ПутьПары = Путь + "[" + Строка(Индекс) + "]";
		ОшибкаЛимита = УчестьЭлемент(ПутьПары, КонтекстСериализации);
		Если ОшибкаЛимита <> Неопределено Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат ОшибкаЛимита;
		КонецЕсли;
		Ключ = КодироватьЗначение(Элемент.Ключ, ПутьПары + ".key", Глубина + 1, КонтекстСериализации);
		Если ЭтоОшибка(Ключ) Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат Ключ;
		КонецЕсли;
		Узел = КодироватьЗначение(Элемент.Значение, ПутьПары + ".value", Глубина + 1, КонтекстСериализации);
		Если ЭтоОшибка(Узел) Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат Узел;
		КонецЕсли;
		Пара = Новый Массив;
		Пара.Добавить(Ключ);
		Пара.Добавить(Узел);
		Пары.Добавить(Пара);
		Индекс = Индекс + 1;
	КонецЦикла;
	ВыйтиИзКонтейнера(КонтекстСериализации);
	Возврат УзелСоЗначением("map", Пары);
КонецФункции

Функция КодироватьСсылку(Значение, МетаданныеОбъекта, Путь, КонтекстСериализации)
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат СоздатьОшибку("unsupported", Путь, Строка(ТипЗнч(Значение)));
	КонецЕсли;
	РежимСсылок = КонтекстСериализации.РежимСсылок;
	ТехническийТип = ТехническоеИмяТипаМетаданных(МетаданныеОбъекта, "Ссылка");
	ОшибкаЛимита = УчестьСтроку(ТехническийТип, Путь, КонтекстСериализации);
	Если ОшибкаЛимита <> Неопределено Тогда
		Возврат ОшибкаЛимита;
	КонецЕсли;
	Пустая = Не ЗначениеЗаполнено(Значение);
	Узел = Новый Структура;
	Узел.Вставить("t", "reference");
	Узел.Вставить("type", ТехническийТип);
	Если Не Пустая И (РежимСсылок = "uuid" Или РежимСсылок = "both") Тогда
		ОшибкаЛимита = УчестьБайты(64, Путь, КонтекстСериализации);
		Если ОшибкаЛимита <> Неопределено Тогда
			Возврат ОшибкаЛимита;
		КонецЕсли;
		Узел.Вставить("uuid", Строка(Значение.УникальныйИдентификатор()));
	Иначе
		Узел.Вставить("uuid", Неопределено);
	КонецЕсли;
	Если РежимСсылок = "presentation" Или РежимСсылок = "both" Тогда
		Представление = Строка(Значение);
		ОшибкаЛимита = УчестьСтроку(Представление, Путь, КонтекстСериализации);
		Если ОшибкаЛимита <> Неопределено Тогда
			Возврат ОшибкаЛимита;
		КонецЕсли;
		Узел.Вставить("presentation", Представление);
	Иначе
		Узел.Вставить("presentation", "");
	КонецЕсли;
	Узел.Вставить("empty", Пустая);
	Возврат Узел;
КонецФункции

Функция КодироватьПеречисление(Значение, МетаданныеОбъекта, Путь, КонтекстСериализации)
	ТехническийТип = "ПеречислениеСсылка." + МетаданныеОбъекта.Имя;
	ИмяЗначения = XMLСтрока(Значение);
	Представление = Строка(Значение);
	ОшибкаЛимита = УчестьСтроку(ТехническийТип, Путь, КонтекстСериализации);
	Если ОшибкаЛимита = Неопределено Тогда
		ОшибкаЛимита = УчестьСтроку(ИмяЗначения, Путь, КонтекстСериализации);
	КонецЕсли;
	Если ОшибкаЛимита = Неопределено Тогда
		ОшибкаЛимита = УчестьСтроку(Представление, Путь, КонтекстСериализации);
	КонецЕсли;
	Если ОшибкаЛимита <> Неопределено Тогда
		Возврат ОшибкаЛимита;
	КонецЕсли;
	Узел = Новый Структура;
	Узел.Вставить("t", "enum");
	Узел.Вставить("type", ТехническийТип);
	Узел.Вставить("name", ИмяЗначения);
	Узел.Вставить("presentation", Представление);
	Возврат Узел;
КонецФункции

Функция КодироватьОбъект(Значение, МетаданныеОбъекта, Путь, Глубина, КонтекстСериализации)
	ОшибкаЦикла = ВойтиВКонтейнер(Значение, Путь, КонтекстСериализации);
	Если ОшибкаЦикла <> Неопределено Тогда
		Возврат ОшибкаЦикла;
	КонецЕсли;
	ИменаРеквизитов = Новый Соответствие;
	Для Каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		ИменаРеквизитов.Вставить(Реквизит.Имя, Истина);
	КонецЦикла;
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		ИменаРеквизитов.Вставить(Реквизит.Имя, Истина);
	КонецЦикла;
	Атрибуты = Новый Массив;
	Для Каждого ЭлементИмени Из ИменаРеквизитов Цикл
		ИмяРеквизита = ЭлементИмени.Ключ;
		ОшибкаЛимита = УчестьСтроку(ИмяРеквизита, Путь, КонтекстСериализации);
		Если ОшибкаЛимита <> Неопределено Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат ОшибкаЛимита;
		КонецЕсли;
		ОшибкаЛимита = УчестьЭлемент(Путь + "." + ИмяРеквизита, КонтекстСериализации);
		Если ОшибкаЛимита <> Неопределено Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат ОшибкаЛимита;
		КонецЕсли;
		Узел = КодироватьЗначение(Значение[ИмяРеквизита], Путь + "." + ИмяРеквизита, Глубина + 1, КонтекстСериализации);
		Если ЭтоОшибка(Узел) Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат Узел;
		КонецЕсли;
		Пара = Новый Массив;
		Пара.Добавить(ИмяРеквизита);
		Пара.Добавить(Узел);
		Атрибуты.Добавить(Пара);
	КонецЦикла;
	ТабличныеЧасти = Новый Массив;
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		ОшибкаЛимита = УчестьЭлемент(Путь + ".sections", КонтекстСериализации);
		Если ОшибкаЛимита = Неопределено Тогда
			ОшибкаЛимита = УчестьСтроку(ТабличнаяЧасть.Имя, Путь, КонтекстСериализации);
		КонецЕсли;
		Если ОшибкаЛимита <> Неопределено Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат ОшибкаЛимита;
		КонецЕсли;
		ТабличныеЧасти.Добавить(ТабличнаяЧасть.Имя);
	КонецЦикла;
	ТехническийТип = ТехническоеИмяТипаМетаданных(МетаданныеОбъекта, "Объект");
	ОшибкаЛимита = УчестьСтроку(ТехническийТип, Путь, КонтекстСериализации);
	Если ОшибкаЛимита <> Неопределено Тогда
		ВыйтиИзКонтейнера(КонтекстСериализации);
		Возврат ОшибкаЛимита;
	КонецЕсли;
	ВыйтиИзКонтейнера(КонтекстСериализации);
	Результат = Новый Структура;
	Результат.Вставить("t", "object");
	Результат.Вставить("type", ТехническийТип);
	Результат.Вставить("attributes", Атрибуты);
	Результат.Вставить("sections", ТабличныеЧасти);
	Возврат Результат;
КонецФункции

Функция КодироватьДерево(Значение, Путь, Глубина, КонтекстСериализации)
	ОшибкаЦикла = ВойтиВКонтейнер(Значение, Путь, КонтекстСериализации);
	Если ОшибкаЦикла <> Неопределено Тогда
		Возврат ОшибкаЦикла;
	КонецЕсли;
	Колонки = Новый Массив;
	Для Каждого Колонка Из Значение.Колонки Цикл
		ОшибкаЛимита = УчестьЭлемент(Путь + ".columns", КонтекстСериализации);
		Если ОшибкаЛимита = Неопределено Тогда
			ОшибкаЛимита = УчестьСтроку(Колонка.Имя, Путь, КонтекстСериализации);
		КонецЕсли;
		Если ОшибкаЛимита <> Неопределено Тогда
			ВыйтиИзКонтейнера(КонтекстСериализации);
			Возврат ОшибкаЛимита;
		КонецЕсли;
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	Строки = КодироватьСтрокиДерева(Значение.Строки, Колонки, Путь + ".rows", Глубина + 1, КонтекстСериализации);
	Если ЭтоОшибка(Строки) Тогда
		ВыйтиИзКонтейнера(КонтекстСериализации);
		Возврат Строки;
	КонецЕсли;
	ВыйтиИзКонтейнера(КонтекстСериализации);
	Результат = Новый Структура;
	Результат.Вставить("t", "tree");
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Возврат Результат;
КонецФункции

Функция КодироватьСтрокиДерева(СтрокиДерева, Колонки, Путь, Глубина, КонтекстСериализации)
	Результат = Новый Массив;
	ИндексСтроки = 0;
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		ПутьСтроки = Путь + "[" + Строка(ИндексСтроки) + "]";
		ОшибкаЛимита = УчестьЭлемент(ПутьСтроки, КонтекстСериализации);
		Если ОшибкаЛимита <> Неопределено Тогда
			Возврат ОшибкаЛимита;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого ИмяКолонки Из Колонки Цикл
			ОшибкаЛимита = УчестьЭлемент(ПутьСтроки + ".values", КонтекстСериализации);
			Если ОшибкаЛимита <> Неопределено Тогда
				Возврат ОшибкаЛимита;
			КонецЕсли;
			Узел = КодироватьЗначение(СтрокаДерева[ИмяКолонки], ПутьСтроки + "." + ИмяКолонки, Глубина + 1, КонтекстСериализации);
			Если ЭтоОшибка(Узел) Тогда
				Возврат Узел;
			КонецЕсли;
			Значения.Добавить(Узел);
		КонецЦикла;
		Дети = КодироватьСтрокиДерева(СтрокаДерева.Строки, Колонки, ПутьСтроки + ".children", Глубина + 1, КонтекстСериализации);
		Если ЭтоОшибка(Дети) Тогда
			Возврат Дети;
		КонецЕсли;
		УзелСтроки = Новый Структура;
		УзелСтроки.Вставить("values", Значения);
		УзелСтроки.Вставить("children", Дети);
		Результат.Добавить(УзелСтроки);
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВойтиВКонтейнер(Значение, Путь, КонтекстСериализации)
	Для Индекс = 0 По КонтекстСериализации.АктивныеЗначения.ВГраница() Цикл
		Если КонтекстСериализации.АктивныеЗначения[Индекс] = Значение Тогда
			Ошибка = СоздатьОшибку("cycle", Путь, 0);
			Ошибка.Вставить("first_path", КонтекстСериализации.АктивныеПути[Индекс]);
			Возврат Ошибка;
		КонецЕсли;
	КонецЦикла;
	КонтекстСериализации.АктивныеЗначения.Добавить(Значение);
	КонтекстСериализации.АктивныеПути.Добавить(Путь);
	Возврат Неопределено;
КонецФункции

Процедура ВыйтиИзКонтейнера(КонтекстСериализации)
	КонтекстСериализации.АктивныеЗначения.Удалить(КонтекстСериализации.АктивныеЗначения.ВГраница());
	КонтекстСериализации.АктивныеПути.Удалить(КонтекстСериализации.АктивныеПути.ВГраница());
КонецПроцедуры

Функция УчестьЭлемент(Путь, КонтекстСериализации)
	КонтекстСериализации.КоличествоЭлементов = КонтекстСериализации.КоличествоЭлементов + 1;
	Если КонтекстСериализации.КоличествоЭлементов > КонтекстСериализации.МаксимумЭлементов Тогда
		Возврат СоздатьОшибку("item_limit", Путь, КонтекстСериализации.МаксимумЭлементов);
	КонецЕсли;
	Возврат УчестьБайты(64, Путь, КонтекстСериализации);
КонецФункции

Функция УчестьСтроку(Значение, Путь, КонтекстСериализации)
	Возврат УчестьБайты(СтрДлина(Значение) * 6 + 16, Путь, КонтекстСериализации);
КонецФункции

Функция УчестьБайты(Количество, Путь, КонтекстСериализации)
	КонтекстСериализации.КоличествоБайтОценка = КонтекстСериализации.КоличествоБайтОценка + Количество;
	Если КонтекстСериализации.КоличествоБайтОценка > КонтекстСериализации.МаксимумБайт Тогда
		Возврат СоздатьОшибку("byte_limit", Путь, КонтекстСериализации.МаксимумБайт);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЭтоОбъектМетаданных(ПолноеИмяМетаданных)
	ЧастиИмени = СтрРазделить(ПолноеИмяМетаданных, ".", Ложь);
	Если ЧастиИмени.Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Префиксы = Новый Массив;
	Префиксы.Добавить("Справочник.");
	Префиксы.Добавить("Документ.");
	Префиксы.Добавить("ПланОбмена.");
	Префиксы.Добавить("ПланСчетов.");
	Префиксы.Добавить("ПланВидовХарактеристик.");
	Префиксы.Добавить("ПланВидовРасчета.");
	Префиксы.Добавить("БизнесПроцесс.");
	Префиксы.Добавить("Задача.");
	Для Каждого Префикс Из Префиксы Цикл
		Если СтрНачинаетсяС(ПолноеИмяМетаданных, Префикс) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ТехническоеИмяТипаМетаданных(МетаданныеОбъекта, ВидЗначения)
	ПолноеИмя = МетаданныеОбъекта.ПолноеИмя();
	ЧастиИмени = СтрРазделить(ПолноеИмя, ".", Ложь);
	Если ЧастиИмени.Количество() <> 2 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат ЧастиИмени[0] + ВидЗначения + "." + ЧастиИмени[1];
КонецФункции

Функция ЭтоСсылка(Значение, МетаданныеОбъекта)
	Если МетаданныеОбъекта = Неопределено
			Или Не ЭтоОбъектМетаданных(МетаданныеОбъекта.ПолноеИмя()) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		ИмяXMLТипа = XMLТипЗнч(Значение).ИмяТипа;
		Возврат СтрНайти(ИмяXMLТипа, "Ref.") > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ЭтоОбъектМетаданныхЗначение(Значение, МетаданныеОбъекта)
	Попытка
		ИмяXMLТипа = XMLТипЗнч(Значение).ИмяТипа;
		Возврат СтрНайти(ИмяXMLТипа, "Object.") > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция УзелБезЗначения(Тег)
	Возврат Новый Структура("t", Тег);
КонецФункции

Функция УзелСоЗначением(Тег, Значение)
	Возврат Новый Структура("t,v", Тег, Значение);
КонецФункции

Функция СоздатьОшибку(Вид, Путь, ДополнительноеЗначение)
	Ошибка = Новый Структура;
	Ошибка.Вставить("__error", Истина);
	Ошибка.Вставить("kind", Вид);
	Ошибка.Вставить("path", Путь);
	Если Вид = "unsupported" Тогда
		Ошибка.Вставить("type", ДополнительноеЗначение);
	ИначеЕсли Вид <> "cycle" Тогда
		Ошибка.Вставить("limit", ДополнительноеЗначение);
	КонецЕсли;
	Возврат Ошибка;
КонецФункции

Функция ЭтоОшибка(Значение)
	ФлагОшибки = Ложь;
	Возврат ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("__error", ФлагОшибки) И ФлагОшибки;
КонецФункции

Функция ДокументОшибки(Ошибка)
	Документ = Новый Структура;
	Для Каждого Элемент Из Ошибка Цикл
		Если Элемент.Ключ <> "__error" Тогда
			Документ.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Документ;
КонецФункции

Функция ВJSON(Значение)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция Base64БезРазрывов(Данные)
	Результат = Base64Строка(Данные);
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Возврат Результат;
КонецФункции

Функция SHA256(Данные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции
