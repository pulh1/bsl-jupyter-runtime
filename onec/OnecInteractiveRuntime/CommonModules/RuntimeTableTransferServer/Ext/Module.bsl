Функция СобратьСсылки(Знач Таблица) Экспорт
	Таблица = ПодготовитьТабличноеЗначение(Таблица);
	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значение = СтрокаТаблицы[Колонка.Имя];
			Если ЭтоСсылка(Значение) Тогда
				Результат.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьПредставленияСсылок(МассивСсылок) Экспорт
	Результат = Новый Массив;
	Для Каждого Ссылка Из МассивСсылок Цикл
		Описание = Новый Структура;
		Пустая = Не ЗначениеЗаполнено(Ссылка);
		МетаданныеСсылки = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
		ТипСсылки = ?(МетаданныеСсылки = Неопределено,
			Строка(ТипЗнч(Ссылка)), МетаданныеСсылки.ПолноеИмя());
		Описание.Вставить("Тип", ТипСсылки);
		Описание.Вставить("UUID", ?(Пустая, Неопределено,
			Строка(Ссылка.УникальныйИдентификатор())));
		Описание.Вставить("Представление", ?(Пустая, "", Строка(Ссылка)));
		Описание.Вставить("Пустая", Пустая);
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СериализоватьТаблицу(Знач Таблица, РазмерЧасти, ПредставленияСсылок) Экспорт
	Таблица = ПодготовитьТабличноеЗначение(Таблица);
	Если РазмерЧасти <= 0 Тогда
		ВызватьИсключение "Размер части должен быть положительным";
	КонецЕсли;
	СтрокиДанных = Новый Массив;
	ВидыКолонок = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ВидыКолонок.Добавить(Новый Структура);
	КонецЦикла;
	ИндексСсылки = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ЗначенияСтроки = Новый Массив;
		ИндексКолонки = 0;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значение = СтрокаТаблицы[Колонка.Имя];
			Если ЭтоСсылка(Значение) Тогда
				Если ИндексСсылки >= ПредставленияСсылок.Количество() Тогда
					ВызватьИсключение "Недостаточно представлений ссылок";
				КонецЕсли;
				ОписаниеСсылки = ПредставленияСсылок[ИндексСсылки];
				Если Не ОписаниеСсылки.Пустая
					И ОписаниеСсылки.UUID <> Строка(Значение.УникальныйИдентификатор()) Тогда
					ВызватьИсключение "UUID представления ссылки не совпадает";
				КонецЕсли;
				Ячейка = Новый Массив;
				Ячейка.Добавить("reference");
				ДанныеСсылки = Новый Структура;
				ДанныеСсылки.Вставить("type", ОписаниеСсылки.Тип);
				ДанныеСсылки.Вставить("uuid", ОписаниеСсылки.UUID);
				ДанныеСсылки.Вставить("presentation", ОписаниеСсылки.Представление);
				ДанныеСсылки.Вставить("empty", ОписаниеСсылки.Пустая);
				Ячейка.Добавить(ДанныеСсылки);
				ИндексСсылки = ИндексСсылки + 1;
				ДобавитьВид(ВидыКолонок[ИндексКолонки], "reference");
			Иначе
				Ячейка = СериализоватьПростоеЗначение(Значение);
				ДобавитьВид(ВидыКолонок[ИндексКолонки], Ячейка[0]);
			КонецЕсли;
			ЗначенияСтроки.Добавить(Ячейка);
			ИндексКолонки = ИндексКолонки + 1;
		КонецЦикла;
		ЗаписьСтроки = Новый Структура;
		ЗаписьСтроки.Вставить("record", "row");
		ЗаписьСтроки.Вставить("values", ЗначенияСтроки);
		СтрокиДанных.Добавить(ЗаписьСтроки);
	КонецЦикла;
	Если ИндексСсылки <> ПредставленияСсылок.Количество() Тогда
		ВызватьИсключение "Лишние представления ссылок";
	КонецЕсли;

	КолонкиСхемы = Новый Массив;
	ИндексКолонки = 0;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ОписаниеКолонки = Новый Структура;
		ОписаниеКолонки.Вставить("name", Колонка.Имя);
		ОписаниеКолонки.Вставить("ordinal", ИндексКолонки);
		Виды = Новый Массив;
		Для Каждого Свойство Из ВидыКолонок[ИндексКолонки] Цикл
			Виды.Добавить(Свойство.Ключ);
		КонецЦикла;
		ОписаниеКолонки.Вставить("kinds", Виды);
		ОписаниеКолонки.Вставить("reference",
			ВидыКолонок[ИндексКолонки].Свойство("reference"));
		КолонкиСхемы.Добавить(ОписаниеКолонки);
		ИндексКолонки = ИндексКолонки + 1;
	КонецЦикла;
	Схема = Новый Структура;
	Схема.Вставить("record", "schema");
	Схема.Вставить("version", 1);
	Схема.Вставить("columns", КолонкиСхемы);
	JSONСхемы = ВJSON(Схема);
	СтрокаСхемы = JSONСхемы + Символы.ПС;
	ТекстДанных = СтрокаСхемы;
	Для Каждого СтрокаДанных Из СтрокиДанных Цикл
		ТекстДанных = ТекстДанных + ВJSON(СтрокаДанных) + Символы.ПС;
	КонецЦикла;
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ТекстДанных, КодировкаТекста.UTF8, Ложь);
	ДвоичныеДанныеСхемы = ПолучитьДвоичныеДанныеИзСтроки(JSONСхемы, КодировкаТекста.UTF8, Ложь);
	Части = Новый Массив;
	РазмерЧастиВСимволах = Макс(1, Цел(РазмерЧасти / 4));
	Позиция = 1;
	Пока Позиция <= СтрДлина(ТекстДанных) Цикл
		Части.Добавить(Base64БезРазрывов(ПолучитьДвоичныеДанныеИзСтроки(
			Сред(ТекстДанных, Позиция, РазмерЧастиВСимволах), КодировкаТекста.UTF8, Ложь)));
		Позиция = Позиция + РазмерЧастиВСимволах;
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("Части", Части);
	Результат.Вставить("Размер", ДвоичныеДанные.Размер());
	Результат.Вставить("РазмерСхемы", ДвоичныеДанныеСхемы.Размер());
	Результат.Вставить("КоличествоЧастей", Части.Количество());
	Результат.Вставить("ХешДанных", SHA256(ДвоичныеДанные));
	Результат.Вставить("ХешСхемы", SHA256(ДвоичныеДанныеСхемы));
	Возврат Результат;
КонецФункции

Функция ПолучитьКомпактнуюСхему(Знач Таблица) Экспорт
	КолонкиТаблицы = ПолучитьКолонкиТабличногоЗначения(Таблица);
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Имя");
	Результат.Колонки.Добавить("Вид");
	Результат.Колонки.Добавить("Ссылка");
	Для Каждого Колонка Из КолонкиТаблицы Цикл
		Описание = ОпределитьОбъявленныйКомпактныйВид(Колонка.ТипЗначения);
		СтрокаСхемы = Результат.Добавить();
		СтрокаСхемы.Имя = Колонка.Имя;
		СтрокаСхемы.Вид = Описание.Вид;
		СтрокаСхемы.Ссылка = Описание.Ссылка;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОпределитьОбъявленныйКомпактныйВид(ОписаниеТипов)
	Вид = "";
	Ссылочный = Ложь;
	ВидОпределен = Ложь;
	Для Каждого ТипКолонки Из ОписаниеТипов.Типы() Цикл
		Если ТипКолонки = Тип("Null") Тогда
			Продолжить;
		ИначеЕсли ТипКолонки = Тип("Строка") Тогда
			ТекущийВид = "nullable_string";
			ТекущийСсылочный = Ложь;
		ИначеЕсли ТипКолонки = Тип("Булево") Тогда
			ТекущийВид = "boolean";
			ТекущийСсылочный = Ложь;
		ИначеЕсли ТипКолонки = Тип("Число") Тогда
			ТекущийВид = "number";
			ТекущийСсылочный = Ложь;
		ИначеЕсли ТипКолонки = Тип("Дата") Тогда
			ТекущийВид = "datetime";
			ТекущийСсылочный = Ложь;
		ИначеЕсли ТипКолонки = Тип("УникальныйИдентификатор") Тогда
			ТекущийВид = "uuid";
			ТекущийСсылочный = Ложь;
		Иначе
			МетаданныеТипа = Метаданные.НайтиПоТипу(ТипКолонки);
			Если МетаданныеТипа = Неопределено Тогда
				Возврат Новый Структура("Вид,Ссылка", "", Ложь);
			КонецЕсли;
			Если СтрНачинаетсяС(МетаданныеТипа.ПолноеИмя(), "Перечисление.") Тогда
				ТекущийВид = "nullable_string";
				ТекущийСсылочный = Ложь;
			Иначе
				ТекущийВид = "reference";
				ТекущийСсылочный = Истина;
			КонецЕсли;
		КонецЕсли;
		Если Не ВидОпределен Тогда
			Вид = ТекущийВид;
			Ссылочный = ТекущийСсылочный;
			ВидОпределен = Истина;
		ИначеЕсли Вид <> ТекущийВид Или Ссылочный <> ТекущийСсылочный Тогда
			Возврат Новый Структура("Вид,Ссылка", "", Ложь);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Вид,Ссылка", Вид, Ссылочный);
КонецФункции

Функция СериализоватьКомпактнуюТаблицу(Знач Таблица, РежимСсылок, РежимыСсылокКолонок, ТипыОбъектовWorker, МаксимумСтрок = 0, МаксимумБайт = 0) Экспорт
	Если МаксимумСтрок < 0 Или МаксимумБайт < 0 Тогда
		ВызватьИсключение "Лимиты компактной таблицы не могут быть отрицательными";
	КонецЕсли;
	Если ЭтоПриватноеЗначениеWorker(Таблица, ТипыОбъектовWorker) Тогда
		Возврат Новый Структура("Доступ", Ложь);
	КонецЕсли;
	Таблица = ПодготовитьТабличноеЗначение(Таблица, МаксимумСтрок);
	ПроверитьРежимСсылок(РежимСсылок);
	СхемаКолонок = ОпределитьКомпактнуюСхемуКолонок(Таблица, ТипыОбъектовWorker, МаксимумСтрок);
	Если СхемаКолонок = Неопределено Тогда
		Возврат Новый Структура("Доступ", Ложь);
	КонецЕсли;
	ИменаКолонок = СхемаКолонок.Имена;
	ВидыКолонок = СхемаКолонок.Виды;
	СсылочныеКолонки = СхемаКолонок.Ссылочные;
	ВидыЗначенийКолонок = Новый Массив;
	Для Каждого ВидЗначенияКолонки Из ВидыКолонок Цикл
		ВидыЗначенийКолонок.Добавить(ВидЗначенияКолонки);
	КонецЦикла;

	РежимыСсылокСхемы = Новый Структура;
	Для ИндексКолонки = 0 По ИменаКолонок.ВГраница() Цикл
		ИмяКолонки = ИменаКолонок[ИндексКолонки];
		Вид = ВидыКолонок[ИндексКолонки];
		РежимКолонки = РежимыСсылокКолонок.Получить(ИмяКолонки);
		Если СсылочныеКолонки[ИндексКолонки] Тогда
			Если РежимКолонки = Неопределено Тогда
				РежимКолонки = РежимСсылок;
			КонецЕсли;
			ПроверитьРежимСсылок(РежимКолонки);
			ВидыКолонок[ИндексКолонки] = РежимКолонки;
			РежимыСсылокСхемы.Вставить(ИмяКолонки, РежимКолонки);
		Иначе
			Если РежимКолонки <> Неопределено Тогда
				ВызватьИсключение "Режим ссылки задан для обычной колонки " + ИмяКолонки;
			КонецЕсли;
			Если Вид = "" Тогда
				ВидыКолонок[ИндексКолонки] = "string";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Схема = Новый Структура;
	Схема.Вставить("version", 1);
	Схема.Вставить("columns", ИменаКолонок);
	Схема.Вставить("kinds", ВидыКолонок);
	Схема.Вставить("reference_modes", РежимыСсылокСхемы);
	СтрокиJSONL = Новый Массив;
	СтрокаСхемыJSONL = ВJSON(Схема);
	СтрокиJSONL.Добавить(СтрокаСхемыJSONL);
	РазмерJSONL = ПолучитьДвоичныеДанныеИзСтроки(СтрокаСхемыJSONL + Символы.ПС,
		КодировкаТекста.UTF8, Ложь).Размер();
	Если МаксимумБайт > 0 И РазмерJSONL > МаксимумБайт Тогда
		ВызватьИсключение "Превышен лимит байтов компактной таблицы";
	КонецЕсли;
	КоличествоСтрокJSONL = 0;
	ОтказДоступа = Ложь;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если МаксимумСтрок > 0 И КоличествоСтрокJSONL >= МаксимумСтрок Тогда
			ВызватьИсключение "Превышен лимит строк компактной таблицы";
		КонецЕсли;
		ЗначенияСтроки = Новый Массив;
		ИндексКолонки = 0;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			ЗначениеЯчейки = СтрокаТаблицы[Колонка.Имя];
			Если ЭтоПриватноеЗначениеWorker(ЗначениеЯчейки, ТипыОбъектовWorker) Тогда
				ОтказДоступа = Истина;
				Прервать;
			КонецЕсли;
			НаблюдаемыйВид = КомпактныйВидЗначения(ЗначениеЯчейки);
			Если НаблюдаемыйВид <> "" И Не СовместимыКомпактныеВиды(
				ВидыЗначенийКолонок[ИндексКолонки], НаблюдаемыйВид) Тогда
				ВызватьИсключение "Несовместимый тип значения компактной колонки: "
					+ Колонка.Имя;
			КонецЕсли;
			ЗначенияСтроки.Добавить(КомпактноеЗначение(ЗначениеЯчейки,
				ВидыКолонок[ИндексКолонки],
				СсылочныеКолонки[ИндексКолонки]));
			ИндексКолонки = ИндексКолонки + 1;
		КонецЦикла;
		Если ОтказДоступа Тогда
			Возврат Новый Структура("Доступ", Ложь);
		КонецЕсли;
		JSONСтроки = ВJSON(ЗначенияСтроки);
		РазмерСтрокиJSONL = ПолучитьДвоичныеДанныеИзСтроки(JSONСтроки + Символы.ПС,
			КодировкаТекста.UTF8, Ложь).Размер();
		Если МаксимумБайт > 0 И РазмерJSONL + РазмерСтрокиJSONL > МаксимумБайт Тогда
			ВызватьИсключение "Превышен лимит байтов компактной таблицы";
		КонецЕсли;
		СтрокиJSONL.Добавить(JSONСтроки);
		РазмерJSONL = РазмерJSONL + РазмерСтрокиJSONL;
		КоличествоСтрокJSONL = КоличествоСтрокJSONL + 1;
	КонецЦикла;
	Возврат ЗавершитьКомпактнуюМатериализацию(СтрокиJSONL);
КонецФункции

Функция ПолучитьКолонкиТабличногоЗначения(ТабличноеЗначение)
	ТипТабличногоЗначения = ТипЗнч(ТабличноеЗначение);
	Если ТипТабличногоЗначения = Тип("ТаблицаЗначений")
			Или ТипТабличногоЗначения = Тип("РезультатЗапроса") Тогда
		Возврат ТабличноеЗначение.Колонки;
	КонецЕсли;
	ВызватьИсключение "Неподдерживаемое табличное значение: "
		+ Строка(ТипТабличногоЗначения);
КонецФункции

Функция ПодготовитьТабличноеЗначение(ТабличноеЗначение, МаксимумСтрок = 0) Экспорт
	ТипТабличногоЗначения = ТипЗнч(ТабличноеЗначение);
	Если ТипТабличногоЗначения = Тип("ТаблицаЗначений") Тогда
		Возврат ТабличноеЗначение;
	КонецЕсли;
	Если ТипТабличногоЗначения <> Тип("РезультатЗапроса") Тогда
		ВызватьИсключение "Неподдерживаемое табличное значение: "
			+ Строка(ТипТабличногоЗначения);
	КонецЕсли;
	Если МаксимумСтрок <= 0 Тогда
		ВызватьИсключение "Для результата запроса требуется положительный лимит строк";
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Для Каждого Колонка Из ПолучитьКолонкиТабличногоЗначения(ТабличноеЗначение) Цикл
		Результат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	ВыборкаДанных = ТабличноеЗначение.Выбрать();
	Пока ВыборкаДанных.Следующий() Цикл
		Если Результат.Количество() >= МаксимумСтрок Тогда
			ВызватьИсключение "Превышен лимит строк компактной таблицы";
		КонецЕсли;
		СтрокаРезультата = Результат.Добавить();
		Для Каждого КолонкаРезультата Из Результат.Колонки Цикл
			СтрокаРезультата[КолонкаРезультата.Имя]
				= ВыборкаДанных[КолонкаРезультата.Имя];
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗавершитьКомпактнуюМатериализацию(СтрокиJSONL) Экспорт
	ТекстJSONL = СтрСоединить(СтрокиJSONL, Символы.ПС) + Символы.ПС;
	ДанныеJSONL = ПолучитьДвоичныеДанныеИзСтроки(ТекстJSONL, КодировкаТекста.UTF8, Ложь);
	Base64JSONL = Base64БезРазрывов(ДанныеJSONL);
	Результат = Новый Структура;
	Результат.Вставить("Доступ", Истина);
	Результат.Вставить("Base64", Base64JSONL);
	Результат.Вставить("Размер", ДанныеJSONL.Размер());
	Результат.Вставить("Хеш", SHA256(ДанныеJSONL));
	Возврат Результат;
КонецФункции

Функция ПолучитьЧасть(Части, НомерЧасти) Экспорт
	Если НомерЧасти < 0 Или НомерЧасти >= Части.Количество() Тогда
		ВызватьИсключение "Номер части вне диапазона";
	КонецЕсли;
	Возврат Части[НомерЧасти];
КонецФункции

Процедура ПроверитьРежимСсылок(Режим)
	Если Режим <> "presentation" И Режим <> "uuid" И Режим <> "both" Тогда
		ВызватьИсключение "Неизвестный режим ссылок";
	КонецЕсли;
КонецПроцедуры

Функция ОпределитьКомпактнуюСхемуКолонок(Таблица, ТипыОбъектовWorker, Знач МаксимумСтрок)
	Если МаксимумСтрок <= 0 Тогда
		МаксимумСтрок = 1;
	КонецЕсли;
	ИменаКолонок = Новый Массив;
	ВидыКолонок = Новый Массив;
	СсылочныеКолонки = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ИменаКолонок.Добавить(Колонка.Имя);
		ОписаниеВида = ОпределитьОбъявленныйКомпактныйВид(Колонка.ТипЗначения);
		Вид = ОписаниеВида.Вид;
		Ссылочный = ОписаниеВида.Ссылка;
		КоличествоПроверенныхСтрок = 0;
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Если КоличествоПроверенныхСтрок >= МаксимумСтрок Тогда
				Прервать;
			КонецЕсли;
			ЗначениеЯчейки = СтрокаТаблицы[Колонка.Имя];
			Если ЭтоПриватноеЗначениеWorker(ЗначениеЯчейки, ТипыОбъектовWorker) Тогда
				Возврат Неопределено;
			КонецЕсли;
			НаблюдаемыйВид = КомпактныйВидЗначения(ЗначениеЯчейки);
			Если Вид = "" И НаблюдаемыйВид <> "" Тогда
				Вид = НаблюдаемыйВид;
				Ссылочный = НаблюдаемыйВид = "reference";
			ИначеЕсли Вид <> "" И НаблюдаемыйВид <> ""
				И Не СовместимыКомпактныеВиды(Вид, НаблюдаемыйВид) Тогда
				ВызватьИсключение "Несовместимый тип значения компактной колонки: "
					+ Колонка.Имя;
			КонецЕсли;
			КоличествоПроверенныхСтрок = КоличествоПроверенныхСтрок + 1;
		КонецЦикла;
		СсылочныеКолонки.Добавить(Ссылочный);
		ВидыКолонок.Добавить(?(Вид = "", "string", Вид));
	КонецЦикла;
	Возврат Новый Структура("Имена,Виды,Ссылочные",
		ИменаКолонок, ВидыКолонок, СсылочныеКолонки);
КонецФункции

Функция СовместимыКомпактныеВиды(ОбъявленныйВид, НаблюдаемыйВид)
	Если ОбъявленныйВид = НаблюдаемыйВид Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ОбъявленныйВид = "nullable_string" И НаблюдаемыйВид = "string";
КонецФункции

Функция ЭтоПриватноеЗначениеWorker(Значение, ТипыОбъектовWorker)
	Если ТипыОбъектовWorker.Найти(ТипЗнч(Значение)) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		ЭтоКореньWorker = Значение.Свойство("ManifestSha256")
			И Значение.Свойство("Modules") И Значение.Свойство("Exports");
		ВидКонтейнераWorker = Неопределено;
		ЭтоЭкспортыWorker = Значение.Свойство("Kind", ВидКонтейнераWorker)
			И ВидКонтейнераWorker = "OnecWorkerExportsV1" И Значение.Свойство("Items");
		Возврат ЭтоКореньWorker Или ЭтоЭкспортыWorker;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого ЭлементWorker Из Значение Цикл
			Если ТипыОбъектовWorker.Найти(ТипЗнч(ЭлементWorker.Значение)) <> Неопределено Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция КомпактныйВидЗначения(Значение)
	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат "";
	ИначеЕсли ЭтоСсылка(Значение) Тогда
		Возврат "reference";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат "string";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат "boolean";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат "number";
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат "datetime";
	ИначеЕсли ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
		Возврат "uuid";
	КонецЕсли;
	ОписаниеВида = ОпределитьОбъявленныйКомпактныйВид(
		Новый ОписаниеТипов(ТипЗнч(Значение)));
	Если ОписаниеВида.Вид <> "" Тогда
		Возврат ОписаниеВида.Вид;
	КонецЕсли;
	ВызватьИсключение "Неподдерживаемый тип компактной таблицы: " + Строка(ТипЗнч(Значение));
КонецФункции

Функция КомпактноеЗначение(Значение, Вид, СсылочноеЗначение)
	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат Неопределено;
	ИначеЕсли СсылочноеЗначение Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат Неопределено;
		ИначеЕсли Вид = "presentation" Тогда
			Возврат Строка(Значение);
		ИначеЕсли Вид = "uuid" Тогда
			Возврат Строка(Значение.УникальныйИдентификатор());
		ИначеЕсли Вид = "both" Тогда
			Результат = Новый Массив;
			Результат.Добавить(Строка(Значение));
			Результат.Добавить(Строка(Значение.УникальныйИдентификатор()));
			Возврат Результат;
		КонецЕсли;
	ИначеЕсли Вид = "nullable_string" Тогда
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Возврат Значение;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(Значение);
	ИначеЕсли Вид = "datetime" Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли Вид = "uuid" Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ЭтоСсылка(Значение)
	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Идентификатор = Значение.УникальныйИдентификатор();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Процедура ДобавитьВид(Виды, Вид)
	Если Не Виды.Свойство(Вид) Тогда
		Виды.Вставить(Вид, Истина);
	КонецЕсли;
КонецПроцедуры

Функция СериализоватьПростоеЗначение(Значение)
	Ячейка = Новый Массив;
	Если Значение = Неопределено Тогда
		Ячейка.Добавить("undefined");
		Ячейка.Добавить(Неопределено);
	ИначеЕсли Значение = NULL Тогда
		Ячейка.Добавить("null");
		Ячейка.Добавить(Неопределено);
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Ячейка.Добавить("string");
		Ячейка.Добавить(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Ячейка.Добавить("boolean");
		Ячейка.Добавить(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Ячейка.Добавить("number");
		Ячейка.Добавить(XMLСтрока(Значение));
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Ячейка.Добавить("datetime");
		Ячейка.Добавить(XMLСтрока(Значение));
	ИначеЕсли ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
		Ячейка.Добавить("uuid");
		Ячейка.Добавить(Строка(Значение));
	Иначе
		ВызватьИсключение "Неподдерживаемый тип таблицы: " + Строка(ТипЗнч(Значение));
	КонецЕсли;
	Возврат Ячейка;
КонецФункции

Функция ВJSON(Значение)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция Base64БезРазрывов(Данные)
	Результат = Base64Строка(Данные);
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Возврат Результат;
КонецФункции

Функция SHA256(Данные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции
