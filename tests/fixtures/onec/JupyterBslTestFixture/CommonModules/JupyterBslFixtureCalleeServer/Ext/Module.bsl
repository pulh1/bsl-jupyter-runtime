Функция ВыполнитьШаг(НачальноеЗначение) Экспорт
    ЛокальныйСчетчик = НачальноеЗначение;
    ЛокальныйMixed = 0;
    ЛокальнаяСтруктура = Новый Структура;
    ЛокальнаяСтруктура.Вставить("Метка", "до");
    ЛокальныеЧисла = Новый Массив;
    ЛокальныеЧисла.Добавить(3);
    ЛокальныеЧисла.Добавить(5);
    ЛокальнаяСтруктура.Вставить("Числа", ЛокальныеЧисла);
    ЛокальнаяСтруктура.Вставить("Пусто", Неопределено);
    ЛокальнаяСтруктура.Вставить("Флаг", Истина);
    ЛокальнаяСтруктура.Вставить("Момент", Дата(2026, 8, 27, 12, 30, 0));
    ЛокальнаяТаблица = Новый ТаблицаЗначений;
    ЛокальнаяТаблица.Колонки.Добавить("Код");
    ЛокальнаяТаблица.Колонки.Добавить("Сумма");
    СтрокаТаблицы = ЛокальнаяТаблица.Добавить();
    СтрокаТаблицы.Код = "A";
    СтрокаТаблицы.Сумма = 10;
    СтрокаТаблицы = ЛокальнаяТаблица.Добавить();
    СтрокаТаблицы.Код = "B";
    СтрокаТаблицы.Сумма = 20;
    СтрокаТаблицы = ЛокальнаяТаблица.Добавить();
    СтрокаТаблицы.Код = "C";
    СтрокаТаблицы.Сумма = 30;
    // JUPYTER_BSL_CAPTURE_CALLEE
    ЛокальныйСчетчик = ЛокальныйСчетчик + 2;
    Возврат Новый Структура(
        "Счетчик,Метка,Таблица,Mixed",
        ЛокальныйСчетчик,
        ЛокальнаяСтруктура.Метка,
        ЛокальнаяТаблица,
        ЛокальныйMixed);
КонецФункции
